digraph CRM_Concept_Curriculum {
    // Graph Configuration
    graph [rankdir=TB, compound=true, splines=polyline, nodesep=0.5, ranksep=0.7, fontname="Helvetica", bgcolor="#FFFFFF"];
    node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=10, margin="0.2,0.1"];
    edge [fontname="Helvetica", fontsize=8, color="#546E7A", arrowsize=0.8];

    subgraph cluster_stage_ug {
        label="Stage 0: Undergraduate Mathematical Foundations";
        style="filled,rounded";
        fillcolor="#E1F5FE40";
        color="#0288D1";
        penwidth=2.0;
        fontsize=12;
        fontname="Helvetica-Bold";

        "UG_LOGIC" [label="Classical Logic & Proof Theory", fillcolor="#E1F5FE", color="#0288D1", penwidth=1.5];
        "UG_ALGEBRA" [label="Abstract Algebra (Groups, Rings, Modules)", fillcolor="#E1F5FE", color="#0288D1", penwidth=1.5];
        "UG_TOPOLOGY" [label="Point-Set Topology", fillcolor="#E1F5FE", color="#0288D1", penwidth=1.5];
        "UG_ORDER" [label="Posets, Lattices & Choice", fillcolor="#E1F5FE", color="#0288D1", penwidth=1.5];
        "UG_COMPUTABILITY" [label="Computability & Recursion Theory", fillcolor="#E1F5FE", color="#0288D1", penwidth=1.5];
        "UG_ANALYSIS" [label="Real Analysis & Metric Spaces", fillcolor="#E1F5FE", color="#0288D1", penwidth=1.5];
        "UG_CATEGORY" [label="First-Course Category Theory", fillcolor="#E1F5FE", color="#0288D1", penwidth=1.5];
    }

    subgraph cluster_stage_grad {
        label="Stage 1: Graduate Foundations & Prerequisite Bridges";
        style="filled,rounded";
        fillcolor="#EDE7F640";
        color="#7E57C2";
        penwidth=2.0;
        fontsize=12;
        fontname="Helvetica-Bold";

        "GRAD_PRESHEAF" [label="Presheaves & Yoneda Lemma", fillcolor="#EDE7F6", color="#7E57C2", penwidth=1.5];
        "GRAD_LAWVERE_THEORY" [label="Lawvere Theories & Algebras", fillcolor="#EDE7F6", color="#7E57C2", penwidth=1.5];
        "GRAD_MONAD_2DOCTRINE" [label="2-Categories & 2-Monadic Doctrines", fillcolor="#EDE7F6", color="#7E57C2", penwidth=1.5];
        "GRAD_CHAIN_COMPLEX" [label="Chain Complexes & Homological Algebra", fillcolor="#EDE7F6", color="#7E57C2", penwidth=1.5];
        "GRAD_SHEAF" [label="Sheaves on Topological Spaces", fillcolor="#EDE7F6", color="#7E57C2", penwidth=1.5];
        "GRAD_ELEM_TOPOS" [label="Elementary Topoi & Subobject Classifier", fillcolor="#EDE7F6", color="#7E57C2", penwidth=1.5];
        "GRAD_SIMPLICIAL_SET" [label="Simplicial Sets & Model Categories", fillcolor="#EDE7F6", color="#7E57C2", penwidth=1.5];
        "GRAD_HYPERDOCTRINE" [label="Lawvere Hyperdoctrines", fillcolor="#EDE7F6", color="#7E57C2", penwidth=1.5];
        "GRAD_DERIVED_CAT" [label="Derived Categories & Spectral Sequences", fillcolor="#EDE7F6", color="#7E57C2", penwidth=1.5];
        "GRAD_AFFINE_SCHEME" [label="Affine Schemes (Spec R)", fillcolor="#EDE7F6", color="#7E57C2", penwidth=1.5];
        "GRAD_SITE" [label="Grothendieck Topologies & Sites", fillcolor="#EDE7F6", color="#7E57C2", penwidth=1.5];
        "GRAD_INTERNAL_LOGIC" [label="Internal Logic & Kripke-Joyal Semantics", fillcolor="#EDE7F6", color="#7E57C2", penwidth=1.5];
        "GRAD_SCHEME" [label="General Schemes & Locally Ringed Spaces", fillcolor="#EDE7F6", color="#7E57C2", penwidth=1.5];
        "GRAD_GROTH_TOPOS" [label="Grothendieck Topoi & Geometric Morphisms", fillcolor="#EDE7F6", color="#7E57C2", penwidth=1.5];
        "GRAD_REALIZABILITY_TOPOS" [label="Triposes & Realizability Topoi (RT/Eff)", fillcolor="#EDE7F6", color="#7E57C2", penwidth=1.5];
        "GRAD_INFINITY_CAT" [label="(inf, 1)-Categories & Quasicategories", fillcolor="#EDE7F6", color="#7E57C2", penwidth=1.5];
        "GRAD_STABLE_INFINITY" [label="Stable (inf, 1)-Categories & Spectra", fillcolor="#EDE7F6", color="#7E57C2", penwidth=1.5];
        "GRAD_CLASS_SET_THEORY" [label="Weak Set Subsystems & Class Theories (ETCS, ZC, NBG)", fillcolor="#EDE7F6", color="#7E57C2", penwidth=1.5];
        "GRAD_COALGEBRA_BISIM" [label="Endofunctor Coalgebras, Bisimulation & Truncations", fillcolor="#EDE7F6", color="#7E57C2", penwidth=1.5];
    }

    subgraph cluster_stage_core {
        label="Stage 2: Monograph Core Framework & Residuum Calculus";
        style="filled,rounded";
        fillcolor="#E8F5E940";
        color="#388E3C";
        penwidth=2.0;
        fontsize=12;
        fontname="Helvetica-Bold";

        "CORE_CRM_PARADIGM" [label="CRM Paradigm: Geometry Over Syntax", fillcolor="#E8F5E9", color="#388E3C", penwidth=1.5];
        "CORE_DOCTRINE" [label="Categorical Doctrine (D in Doct)", fillcolor="#E8F5E9", color="#388E3C", penwidth=1.5];
        "CORE_TRIPLE" [label="Doctrinal Comparison Triple (T)", fillcolor="#E8F5E9", color="#388E3C", penwidth=1.5];
        "CORE_RESIDUUM" [label="Categorical Residuum Operator (Res)", fillcolor="#E8F5E9", color="#388E3C", penwidth=1.5];
        "CORE_FUND_EQUIV" [label="Fundamental Equivalence of CRM", fillcolor="#E8F5E9", color="#388E3C", penwidth=1.5];
        "CORE_TOPOS_RESIDUUM" [label="Topos-Logical Relative Pseudocomplement", fillcolor="#E8F5E9", color="#388E3C", penwidth=1.5];
        "CORE_AXIS_1" [label="Axis I: Choice / Splitting Coordinate Axis", fillcolor="#E8F5E9", color="#388E3C", penwidth=1.5];
        "CORE_AXIS_2" [label="Axis II: Constructive Logic & Omega-Geometry", fillcolor="#E8F5E9", color="#388E3C", penwidth=1.5];
        "CORE_AXIS_3" [label="Axis III: Arithmetic Infinity & Rigidity", fillcolor="#E8F5E9", color="#388E3C", penwidth=1.5];
        "CORE_AXIS_4" [label="Axis IV: Characteristic & p-Torsion", fillcolor="#E8F5E9", color="#388E3C", penwidth=1.5];
        "CORE_AXIS_5" [label="Axis V: Directional Invertibility & Higher Cells", fillcolor="#E8F5E9", color="#388E3C", penwidth=1.5];
        "CORE_RELATIVIZATION" [label="Two-Axis Relativization Framework", fillcolor="#E8F5E9", color="#388E3C", penwidth=1.5];
        "CORE_BASE_FIBER" [label="Base-Fiber Conservation Principle", fillcolor="#E8F5E9", color="#388E3C", penwidth=1.5];
        "CORE_AXIS_6" [label="Axis VI: Quotient-Image Descent & Small-Map AST (C, S)", fillcolor="#E8F5E9", color="#388E3C", penwidth=1.5];
        "CORE_AXIS_7" [label="Axis VII: Foundation vs. Anti-Foundation (mu P_S -> nu P_S)", fillcolor="#E8F5E9", color="#388E3C", penwidth=1.5];
    }

    subgraph cluster_stage_witness {
        label="Stage 3: The Five Foundational Anchor Witnesses";
        style="filled,rounded";
        fillcolor="#FFF3E040";
        color="#F57C00";
        penwidth=2.0;
        fontsize=12;
        fontname="Helvetica-Bold";

        "WITNESS_1_T_ODD" [label="Witness I: Parity Torsor T_odd in Nom", fillcolor="#FFF3E0", color="#F57C00", penwidth=1.5];
        "WITNESS_2_R2_DUALINT" [label="Witness II: 2-Torsion delta-Ring R_2 & DualInt", fillcolor="#FFF3E0", color="#F57C00", penwidth=1.5];
        "WITNESS_3_STEP_PROD_Q" [label="Witness III: Gaunt Step-Product Q & Phantom", fillcolor="#FFF3E0", color="#F57C00", penwidth=1.5];
        "WITNESS_4_FACET_CYCLE" [label="Witness IV: Directed Facet Cycles F_3 / F_n", fillcolor="#FFF3E0", color="#F57C00", penwidth=1.5];
        "WITNESS_5_Q_E0_UHF" [label="Witness V: Light Condensed Q_E0 & UHF(2^inf)", fillcolor="#FFF3E0", color="#F57C00", penwidth=1.5];
    }

    subgraph cluster_stage_adv {
        label="Stage 4: Advanced Synthesis, Lean Formalization & Research Horizons";
        style="filled,rounded";
        fillcolor="#FCE4EC40";
        color="#C2185B";
        penwidth=2.0;
        fontsize=12;
        fontname="Helvetica-Bold";

        "ADV_NON_AC_LATTICES" [label="Seven Multi-Dimensional Non-AC Lattices", fillcolor="#FCE4EC", color="#C2185B", penwidth=1.5];
        "ADV_POSTNIKOV_CHOICE" [label="Higher Choice AC_(n,m) & Postnikov Gerbes", fillcolor="#FCE4EC", color="#C2185B", penwidth=1.5];
        "ADV_CHOICE_ATLAS" [label="Choice-Geometry Residuum Atlas", fillcolor="#FCE4EC", color="#C2185B", penwidth=1.5];
        "ADV_SITE_REALIZABILITY" [label="Site Combinatorics & Kihara Atomic Spectrum", fillcolor="#FCE4EC", color="#C2185B", penwidth=1.5];
        "ADV_INFTY_INFTY_LADDER" [label="Four-Tier (inf, inf)-Ladder & Hom-Rank", fillcolor="#FCE4EC", color="#C2185B", penwidth=1.5];
        "ADV_CUBICAL_AMALGAMATION" [label="Cubical Disjoint n-Amalgamation Dichotomy", fillcolor="#FCE4EC", color="#C2185B", penwidth=1.5];
        "ADV_CORE_CONJECTURES" [label="The Five Core Conjectures of CRM", fillcolor="#FCE4EC", color="#C2185B", penwidth=1.5];
        "ADV_CATSP_SPECTRA" [label="Categorical Spectra CatSp & Stabilization", fillcolor="#FCE4EC", color="#C2185B", penwidth=1.5];
        "ADV_DOUBLE_SOLVENT" [label="Double-Solvent Theorem for 4-Smoothings", fillcolor="#FCE4EC", color="#C2185B", penwidth=1.5];
        "ADV_CLASS_FIBRATION_GC" [label="Class Kaleidoscope Def -| pi_Set & GC Non-Conservativity", fillcolor="#FCE4EC", color="#C2185B", penwidth=1.5];
        "ADV_BOFFA_ANIMA_TORSORS" [label="Boffa Hyperset Torsors & Univalent nu P_Anima Loops", fillcolor="#FCE4EC", color="#C2185B", penwidth=1.5];
        "ADV_DOUBLE_CLAMPED_SETS" [label="Double-Clamped Set_ZFC Scale-Invariance & SetsResiduum", fillcolor="#FCE4EC", color="#C2185B", penwidth=1.5];
        "ADV_HOMOTOPY_CRM" [label="Lean 4 HomotopyCRM Production Ledger", fillcolor="#FCE4EC", color="#C2185B", penwidth=1.5];
        "ADV_OPEN_HORIZONS" [label="17 Open Problems across Eight Horizons", fillcolor="#FCE4EC", color="#C2185B", penwidth=1.5];
        "ADV_EPILOGUE_SYNTHESIS" [label="Epilogue: Truth as Obstruction Invariant", fillcolor="#FCE4EC", color="#C2185B", penwidth=1.5];
    }

    // Prerequisite Dependency Edges (A -> B means A is a prerequisite for B)
    "UG_LOGIC" -> "UG_ORDER";
    "UG_LOGIC" -> "UG_COMPUTABILITY";
    "UG_LOGIC" -> "GRAD_HYPERDOCTRINE";
    "UG_LOGIC" -> "GRAD_CLASS_SET_THEORY";
    "UG_LOGIC" -> "CORE_CRM_PARADIGM";
    "UG_ALGEBRA" -> "UG_CATEGORY";
