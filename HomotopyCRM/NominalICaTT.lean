/-- Derived sanity lemma 1: every `FreshCell` has an open stabilizer in `Cont(Sym(ℕ))`. -/
theorem icatt_stabilizer_open_equiv_check (c : FreshCell) :
    IsOpenSubgroup (MulAction.stabilizer (Equiv.Perm ℕ) c) :=
  (hasFiniteSupport_iff_isOpenSubgroup_stabilizer c).mp (hasFiniteSupport_freshCell c)

/-- Derived sanity lemma 2: permutation action transports singleton supports equivariantly. -/
theorem icatt_smul_support_pushforward_check (g : Equiv.Perm ℕ) (a : ℕ) :
    Supports (({a} : Finset ℕ).image ⇑g) (g • FreshCell.singleton a) := by
  have hs : Supports ({a} : Finset ℕ) (FreshCell.singleton a) := by
    intro σ hσ
    ext1
    simpa [FreshCell.singleton] using hσ a (Finset.mem_singleton_self a)
  exact supports_smul_image hs g

/-- Derived sanity lemma 3: every `FreshStream.truncate n` inherits any support of a prefix
from `S.card ≥ n`. -/
theorem icatt_finite_depth_support_lower_bound_check {n : ℕ} {S : Finset ℕ} {c : FreshChain n}
    (hS : Supports S c) : n ≤ S.card :=
  card_le_of_supports_freshChain hS

/-- Derived sanity lemma 4: constructive soundness from `PureInvStream` to `CoindStepRel` on a
reflexive diagonal step relation `fun x y p q : FreshCell ↦ x = y ∧ p = q`. -/
theorem icatt_constructive_soundness_check
    (s : PureInvStream (fun x y p q : FreshCell ↦ x = y ∧ p = q) FreshCell.root FreshCell.root) :
    CoindStepRel (fun x y p q : FreshCell ↦ x = y ∧ p = q) FreshCell.root FreshCell.root :=
  pureInvStream_sound_coindStepRel (fun _ ↦ ⟨rfl, rfl⟩) s

/-- Derived sanity lemma 5: constructive soundness from `GlobularInvTree coindArrow` to
`IsCoindEquiv coindArrow`. -/
theorem icatt_globular_tree_soundness_check (T : GlobularInvTree coindArrow) :
    IsCoindEquiv coindArrow :=
  globularInvTree_isCoindEquiv T

