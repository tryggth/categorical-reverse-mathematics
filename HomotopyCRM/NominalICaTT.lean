/-!
# Choice Calibration of Internal Coinductive Invertibility Streams (`Theorem 9B`)

This module formalizes **Theorem 9B** (Chapter 6, §6.8, Theorem 6.8.1) of the *Categorical Reverse
Mathematics* monograph, calibrating the internal Dependent Choice (`IDC_ω ≡ DC_ω`, Kihara Rung 0 →
Rung 1) threshold separating relational coinductive greatest fixed points `E_rel = νΦ` from
inhabited coinductive witness streams `im(InvStr)` for internal weak `ω`-category / clan models
`Clan(S_CaTT, E)` (`arXiv:2602.16602`, `arXiv:2610.38698`):

1. **Relational Coinduction & Classical `DC_ω` Surjectivity (`Section 1`):**
   - Formalizes step-sound relations `IsStepSound Step R`, reflexive step transitions
     `IsReflStep Step`, the relational greatest fixed point `CoindStepRel Step`, and the witness
     stream type `InvStream Step R x y` with underlying-pair projection `InvStream.toRel`.
   - Proves constructively (**zero `Classical.choice`**) that every pure witness stream lands inside
     the relational greatest fixed point (`pureInvStream_sound_coindStepRel` : `im(InvStr) ⊆ E_rel`).
   - Proves via `Classical.choice` (`DC_ω`) that `InvStream.toRel` is **surjective** onto any
     step-sound relation `R` (`surjective_toRel_of_stepSound`), yielding
     `coindStepRel_iff_nonempty_pureInvStream`.

2. **Globular Witness Trees for `GlobularInfSystem` (`Section 2`):**
   - Connects directly to `HomotopyCRM.GlobularInfSystem` and `HomotopyCRM.IsCoindEquiv`
     (`OrdinalRankCompleteness.lean`) via infinite binary cancellation trees `GlobularInvTree f`.
   - Proves constructively (**zero `Classical.choice`**) that `GlobularInvTree f → IsCoindEquiv f`
     (`globularInvTree_isCoindEquiv`), and via `Classical.choice` that
     `IsCoindEquiv f ↔ Nonempty (GlobularInvTree f)`.

3. **Nominal Finite-Support Algebra, `FreshChain n`, and `FreshStream` in `Nom` (`Section 3`):**
   - Equips `Equiv.Perm ℕ`-sets with `Supports S x`, `HasFiniteSupport x`, and `IsEquivariant x`,
     matching `IsOpenSubgroup (MulAction.stabilizer (Equiv.Perm ℕ) x)` from `NominalSimplicity`.
   - Separates finite-depth truncations `FreshChain n` (locally split over any finite support
     `S` with `n ≤ S.card`, `exists_freshChain_supported_of_card_le`, yet non-equivariant for
     `n + 1`) from infinite fresh streams `FreshStream`, which fail `HasFiniteSupport` universally
     by explicit atom-swapping transpositions (`exists_swap_stabilizer_ne_on_freshStream`).

4. **Fresh-Atom Computad Spine `E[𝔸]` & Theorem 9B (`Section 4`):**
   - Models the internal fresh-atom computad spine `FreshCell` (`Nodup` atom lists, globally
     equivariant at `FreshCell.root = []`) and `Equiv.Perm ℕ`-equivariant step relation
     `FreshComputadStep`, proving step-soundness `isStepSound_freshDiagRel` on `FreshDiagRel`.
   - Shows in **Theorem 9B** (`theorem9B_choice_calibration_of_coinductive_streams`) that while
     `Set` (`DC_ω`) surjectively realizes `FreshRootStream` (`Nonempty FreshRootStream`) and every
     finite depth `n < ω` splits locally in `Nom`, the nominal object of finitely supported witness
     streams over `FreshCell.root` is **empty** (`IsEmpty {s : FreshRootStream // HasFiniteSupport s}`).

5. **Mandatory 4-Layer Definition Check Gate (`namespace Checks`):**
   - Certifies Carrier Inhabitation (Layer 1), Bidirectional Separation (Layer 2), Mathlib
     projections & derived boundary lemmas (Layer 3), and `#guard_msgs in #print axioms`
     confirming exact axiom footprints (including `choice`-free constructive soundness vs.
     `Classical.choice`-dependent `DC_ω` surjectivity) with `0` `sorry`, `0` `axiom`, `0` `opaque`.
-/

namespace HomotopyCRM

universe u

/-! ## Section 1: Relational Coinduction & `DC_ω` Surjectivity of `InvStream` -/

/-- A binary relation `R : α → α → Prop` is **step-sound** for a 1-step witness transition
`Step : α → α → α → α → Prop` if every `(x, y)` related by `R` admits a next witness pair `(p, q)`
validating `Step x y p q` and remaining inside `R`. -/
def IsStepSound {α : Type u} (Step : α → α → α → α → Prop) (R : α → α → Prop) : Prop :=
  ∀ x y : α, R x y → ∃ p q : α, Step x y p q ∧ R p q

/-- A 1-step transition relation `Step` is **reflexive on diagonal pairs** when every `x` steps
to itself. -/
def IsReflStep {α : Type u} (Step : α → α → α → α → Prop) : Prop :=
  ∀ x : α, Step x x x x

/-- The coinductive greatest reflexive step-sound fixed point `E_rel = νΦ` generated by `Step`. -/
def CoindStepRel {α : Type u} (Step : α → α → α → α → Prop) (x y : α) : Prop :=
  ∃ R : α → α → Prop, Reflexive R ∧ IsStepSound Step R ∧ R x y

/-- `CoindStepRel Step` is reflexive whenever `Step` satisfies `IsReflStep`. -/
theorem coindStepRel_refl {α : Type u} {Step : α → α → α → α → Prop}
    (hRefl : IsReflStep Step) : Reflexive (CoindStepRel Step) := by
  intro x
  refine ⟨Eq, fun _ ↦ rfl, ?_, rfl⟩
  intro a b hab
  subst hab
  exact ⟨a, a, hRefl a, rfl⟩

/-- `CoindStepRel Step` is itself step-sound for `Step`. -/
theorem isStepSound_coindStepRel {α : Type u} (Step : α → α → α → α → Prop) :
    IsStepSound Step (CoindStepRel Step) := by
  intro x y ⟨R, hRrefl, hRsound, hxy⟩
  rcases hRsound x y hxy with ⟨p, q, hstep, hpq⟩
  exact ⟨p, q, hstep, ⟨R, hRrefl, hRsound, hpq⟩⟩

/-- An infinite coinductive invertibility stream witness (`InvStream Step R x y`) recording an
`ω`-chain of `R`-related pairs starting at `(x, y)` and chained by `Step`. -/
@[ext]
structure InvStream {α : Type u} (Step : α → α → α → α → Prop) (R : α → α → Prop)
    (x y : α) : Type u where
  /-- Sequence of witness pairs indexed by `n : ℕ`. -/
  pair : ℕ → α × α
  /-- Root condition anchoring stage `0` at `(x, y)`. -/
  zero_eq : pair 0 = (x, y)
  /-- Invariant keeping every stage inside `R`. -/
  rel_mem : ∀ n : ℕ, R (pair n).1 (pair n).2
  /-- 1-step transition witness from stage `n` to stage `n + 1`. -/
  step_valid : ∀ n : ℕ, Step (pair n).1 (pair n).2 (pair (n + 1)).1 (pair (n + 1)).2

/-- Pure coinductive invertibility streams without an auxiliary invariant relation. -/
abbrev PureInvStream {α : Type u} (Step : α → α → α → α → Prop) (x y : α) : Type u :=
  InvStream Step (fun _ _ ↦ True) x y

/-- Underlying-pair projection `InvStream.toRel` mapping a total stream witness onto its root pair
inside `{xy : α × α // R xy.1 xy.2}`. -/
def InvStream.toRel {α : Type u} {Step : α → α → α → α → Prop} {R : α → α → Prop}
    (s : Σ xy : α × α, InvStream Step R xy.1 xy.2) : {xy : α × α // R xy.1 xy.2} :=
  ⟨s.1, by
    have h0 := s.2.rel_mem 0
    rw [s.2.zero_eq] at h0
    exact h0⟩

/-- **Constructive Soundness (`im(InvStr) ⊆ E_rel`):** Every pure coinductive stream witness
establishes `CoindStepRel Step x y` **without `Classical.choice`**. -/
theorem pureInvStream_sound_coindStepRel {α : Type u} {Step : α → α → α → α → Prop}
    (hRefl : IsReflStep Step) {x y : α} (s : PureInvStream Step x y) :
    CoindStepRel Step x y := by
  refine ⟨fun u v ↦ u = v ∨ ∃ n : ℕ, s.pair n = (u, v), fun u ↦ Or.inl rfl, ?_,
    Or.inr ⟨0, s.zero_eq⟩⟩
  intro u v huv
  cases huv with
  | inl heq =>
    subst heq
    exact ⟨u, u, hRefl u, Or.inl rfl⟩
  | inr hpair =>
    rcases hpair with ⟨n, hn⟩
    have hst : Step (s.pair n).1 (s.pair n).2 (s.pair (n + 1)).1 (s.pair (n + 1)).2 :=
      s.step_valid n
    have h1 : (s.pair n).1 = u := congrArg Prod.fst hn
    have h2 : (s.pair n).2 = v := congrArg Prod.snd hn
    rw [h1, h2] at hst
    exact ⟨(s.pair (n + 1)).1, (s.pair (n + 1)).2, hst, Or.inr ⟨n + 1, rfl⟩⟩

private noncomputable def nextWitnessPair {α : Type u} {Step : α → α → α → α → Prop}
    {R : α → α → Prop} (hSound : IsStepSound Step R) (z : {p : α × α // R p.1 p.2}) :
    {p : α × α // R p.1 p.2} :=
  let hp := Classical.choose (hSound z.1.1 z.1.2 z.2)
  let hq := Classical.choose (Classical.choose_spec (hSound z.1.1 z.1.2 z.2))
  let hspec := Classical.choose_spec (Classical.choose_spec (hSound z.1.1 z.1.2 z.2))
  ⟨(hp, hq), hspec.2⟩

private theorem nextWitnessPair_step {α : Type u} {Step : α → α → α → α → Prop}
    {R : α → α → Prop} (hSound : IsStepSound Step R) (z : {p : α × α // R p.1 p.2}) :
    Step z.1.1 z.1.2 (nextWitnessPair hSound z).1.1 (nextWitnessPair hSound z).1.2 :=
  (Classical.choose_spec (Classical.choose_spec (hSound z.1.1 z.1.2 z.2))).1

/-- Builds a full `InvStream` starting at any `R`-related pair via `DC_ω` (`Classical.choice`). -/
noncomputable def buildInvStreamOfStepSound {α : Type u} {Step : α → α → α → α → Prop}
    {R : α → α → Prop} (hSound : IsStepSound Step R) {x y : α} (hxy : R x y) :
    InvStream Step R x y :=
  let seq : ℕ → {p : α × α // R p.1 p.2} :=
    Nat.rec ⟨(x, y), hxy⟩ (fun _ cur ↦ nextWitnessPair hSound cur)
  { pair := fun n ↦ (seq n).1
    zero_eq := rfl
    rel_mem := fun n ↦ (seq n).2
    step_valid := fun n ↦ nextWitnessPair_step hSound (seq n) }

/-- **Classical `DC_ω` Surjectivity (`E_rel ⊆ im(InvStr)`):** For every step-sound relation `R`,
the underlying-pair projection `InvStream.toRel` is surjective onto `{xy : α × α // R xy.1 xy.2}`. -/
theorem surjective_toRel_of_stepSound {α : Type u} {Step : α → α → α → α → Prop}
    {R : α → α → Prop} (hSound : IsStepSound Step R) :
    Function.Surjective (InvStream.toRel (Step := Step) (R := R)) := by
  rintro ⟨⟨x, y⟩, hxy⟩
  exact ⟨⟨(x, y), buildInvStreamOfStepSound hSound hxy⟩, rfl⟩

/-- Classical equivalence between relational coinduction `CoindStepRel Step x y` and inhabitation
of `PureInvStream Step x y`. -/
theorem coindStepRel_iff_nonempty_pureInvStream {α : Type u} {Step : α → α → α → α → Prop}
    (hRefl : IsReflStep Step) (x y : α) :
    CoindStepRel Step x y ↔ Nonempty (PureInvStream Step x y) := by
  constructor
  · rintro ⟨R, _, hSound, hxy⟩
    let s := buildInvStreamOfStepSound hSound hxy
    exact ⟨⟨s.pair, s.zero_eq, fun _ ↦ trivial, s.step_valid⟩⟩
  · rintro ⟨s⟩
    exact pureInvStream_sound_coindStepRel hRefl s

/-! ## Section 2: Globular Witness Trees for `GlobularInfSystem` -/

/-- Binary cancellation branch address (`false` = left unit `η`, `true` = right counit `ε`). -/
abbrev InvPath := List Bool

/-- Bundled cell in a `GlobularInfSystem S`, avoiding heterogeneous equality casts. -/
structure GlobularCell (S : Type u) [GlobularInfSystem S] : Type u where
  /-- Ambient hom-state classifying the endpoints `src` and `tgt`. -/
  state : S
  /-- Source cell inside `Obj state`. -/
  src : GlobularInfSystem.Obj state
  /-- Target cell inside `Obj state`. -/
  tgt : GlobularInfSystem.Obj state
  /-- Cell inhabitant `src → tgt`. -/
  mor : GlobularInfSystem.Obj (GlobularInfSystem.hom src tgt)

/-- One-step cancellation data `(g, η, ε)` over a bundled cell `c : GlobularCell S`. -/
structure GlobularCancelStep {S : Type u} [GlobularInfSystem S] (c : GlobularCell S) : Type u where
  /-- Candidate reverse morphism `c.tgt → c.src`. -/
  inv : GlobularInfSystem.Obj (GlobularInfSystem.hom c.tgt c.src)
  /-- Higher unit cancellation cell `c.mor ≫ inv ⇒ id c.src`. -/
  eta : GlobularInfSystem.Obj
    (GlobularInfSystem.hom (GlobularInfSystem.compMor c.mor inv) (GlobularInfSystem.idMor c.src))
  /-- Higher counit cancellation cell `inv ≫ c.mor ⇒ id c.tgt`. -/
  eps : GlobularInfSystem.Obj
    (GlobularInfSystem.hom (GlobularInfSystem.compMor inv c.mor) (GlobularInfSystem.idMor c.tgt))

/-- The left (`η`) child cell extracted from a `GlobularCancelStep`. -/
def GlobularCancelStep.etaCell {S : Type u} [GlobularInfSystem S] {c : GlobularCell S}
    (st : GlobularCancelStep c) : GlobularCell S where
  state := GlobularInfSystem.hom c.src c.src
  src := GlobularInfSystem.compMor c.mor st.inv
  tgt := GlobularInfSystem.idMor c.src
  mor := st.eta

/-- The right (`ε`) child cell extracted from a `GlobularCancelStep`. -/
def GlobularCancelStep.epsCell {S : Type u} [GlobularInfSystem S] {c : GlobularCell S}
    (st : GlobularCancelStep c) : GlobularCell S where
  state := GlobularInfSystem.hom c.tgt c.tgt
  src := GlobularInfSystem.compMor st.inv c.mor
  tgt := GlobularInfSystem.idMor c.tgt
  mor := st.eps

/-- Coinductive binary cancellation witness tree `GlobularInvTree f` for a `1`-morphism `f` in a
`GlobularInfSystem S`. -/
structure GlobularInvTree {S : Type u} [GlobularInfSystem S]
    {s : S} {x y : GlobularInfSystem.Obj s}
    (f : GlobularInfSystem.Obj (GlobularInfSystem.hom x y)) : Type u where
  /-- Bundled cell at binary address `p : InvPath`. -/
  node : InvPath → GlobularCell S
  /-- 1-step cancellation data at node `p`. -/
  step : ∀ p : InvPath, GlobularCancelStep (node p)
  /-- Root condition at `[]`. -/
  root_eq : node [] = ⟨s, x, y, f⟩
  /-- Left (`η`) child transition law. -/
  eta_eq : ∀ p : InvPath, node (false :: p) = (step p).etaCell
  /-- Right (`ε`) child transition law. -/
  eps_eq : ∀ p : InvPath, node (true :: p) = (step p).epsCell

private theorem globularCancelStep_unpack {S : Type u} [GlobularInfSystem S]
    {c : GlobularCell S} (st : GlobularCancelStep c)
    {t : S} {u w : GlobularInfSystem.Obj t}
    {h : GlobularInfSystem.Obj (GlobularInfSystem.hom u w)}
    (hc : c = ⟨t, u, w, h⟩) :
    ∃ (g : GlobularInfSystem.Obj (GlobularInfSystem.hom w u))
      (η : GlobularInfSystem.Obj
        (GlobularInfSystem.hom (GlobularInfSystem.compMor h g) (GlobularInfSystem.idMor u)))
      (ε : GlobularInfSystem.Obj
        (GlobularInfSystem.hom (GlobularInfSystem.compMor g h) (GlobularInfSystem.idMor w))),
      st.etaCell =
        ⟨GlobularInfSystem.hom u u,
          GlobularInfSystem.compMor h g, GlobularInfSystem.idMor u, η⟩ ∧
      st.epsCell =
        ⟨GlobularInfSystem.hom w w,
          GlobularInfSystem.compMor g h, GlobularInfSystem.idMor w, ε⟩ := by
  cases hc
  exact ⟨st.inv, st.eta, st.eps, rfl, rfl⟩

/-- **Constructive Globular Tree Soundness (`zero Classical.choice`):** Any `GlobularInvTree f`
certifies `IsCoindEquiv f`. -/
theorem globularInvTree_isCoindEquiv {S : Type u} [GlobularInfSystem S]
    {s : S} {x y : GlobularInfSystem.Obj s}
    {f : GlobularInfSystem.Obj (GlobularInfSystem.hom x y)}
    (T : GlobularInvTree f) : IsCoindEquiv f := by
  refine ⟨fun {t u w} h ↦ ∃ p : InvPath, T.node p = ⟨t, u, w, h⟩, ⟨[], T.root_eq⟩, ?_⟩
  rintro t u w h ⟨p, hp⟩
  rcases globularCancelStep_unpack (T.step p) hp with ⟨g, η, ε, hη, hε⟩
  refine ⟨g, η, ε, ⟨false :: p, ?_⟩, ⟨true :: p, ?_⟩⟩
  · exact (T.eta_eq p).trans hη
  · exact (T.eps_eq p).trans hε

private noncomputable def nextCellWitness {S : Type u} [GlobularInfSystem S]
    (Inv : ∀ {t : S} {u w : GlobularInfSystem.Obj t},
      GlobularInfSystem.Obj (GlobularInfSystem.hom u w) → Prop)
    (hStep : ∀ {t : S} {u w : GlobularInfSystem.Obj t}
      {h : GlobularInfSystem.Obj (GlobularInfSystem.hom u w)}, Inv h →
      ∃ (g : GlobularInfSystem.Obj (GlobularInfSystem.hom w u))
        (η : GlobularInfSystem.Obj
          (GlobularInfSystem.hom (GlobularInfSystem.compMor h g) (GlobularInfSystem.idMor u)))
        (ε : GlobularInfSystem.Obj
          (GlobularInfSystem.hom (GlobularInfSystem.compMor g h) (GlobularInfSystem.idMor w))),
        Inv η ∧ Inv ε)
    (c : {c : GlobularCell S // Inv c.mor}) :
    {st : GlobularCancelStep c.1 // Inv st.etaCell.mor ∧ Inv st.epsCell.mor} :=
  let hg := Classical.choose (hStep c.2)
  let hη := Classical.choose (Classical.choose_spec (hStep c.2))
  let hε := Classical.choose (Classical.choose_spec (Classical.choose_spec (hStep c.2)))
  let hspec := Classical.choose_spec (Classical.choose_spec (Classical.choose_spec (hStep c.2)))
  ⟨⟨hg, hη, hε⟩, hspec⟩

private noncomputable def buildWitnessNode {S : Type u} [GlobularInfSystem S]
    (Inv : ∀ {t : S} {u w : GlobularInfSystem.Obj t},
      GlobularInfSystem.Obj (GlobularInfSystem.hom u w) → Prop)
    (hStep : ∀ {t : S} {u w : GlobularInfSystem.Obj t}
      {h : GlobularInfSystem.Obj (GlobularInfSystem.hom u w)}, Inv h →
      ∃ (g : GlobularInfSystem.Obj (GlobularInfSystem.hom w u))
        (η : GlobularInfSystem.Obj
          (GlobularInfSystem.hom (GlobularInfSystem.compMor h g) (GlobularInfSystem.idMor u)))
        (ε : GlobularInfSystem.Obj
          (GlobularInfSystem.hom (GlobularInfSystem.compMor g h) (GlobularInfSystem.idMor w))),
        Inv η ∧ Inv ε)
    (root : {c : GlobularCell S // Inv c.mor}) :
    InvPath → {c : GlobularCell S // Inv c.mor}
  | [] => root
  | false :: p =>
      let prev := buildWitnessNode Inv hStep root p
      let w := nextCellWitness Inv hStep prev
      ⟨w.1.etaCell, w.2.1⟩
  | true :: p =>
      let prev := buildWitnessNode Inv hStep root p
      let w := nextCellWitness Inv hStep prev
      ⟨w.1.epsCell, w.2.2⟩

/-- Classical equivalence between `IsCoindEquiv f` and inhabitation of the binary witness tree
`GlobularInvTree f`. -/
theorem isCoindEquiv_iff_nonempty_globularInvTree {S : Type u} [GlobularInfSystem S]
    {s : S} {x y : GlobularInfSystem.Obj s}
    (f : GlobularInfSystem.Obj (GlobularInfSystem.hom x y)) :
    IsCoindEquiv f ↔ Nonempty (GlobularInvTree f) := by
  constructor
  · rintro ⟨Inv, hInvf, hStep⟩
    let root : {c : GlobularCell S // Inv c.mor} := ⟨⟨s, x, y, f⟩, hInvf⟩
    let nodes := buildWitnessNode Inv hStep root
    refine ⟨{
      node := fun p ↦ (nodes p).1
      step := fun p ↦ (nextCellWitness Inv hStep (nodes p)).1
      root_eq := rfl
      eta_eq := fun _ ↦ rfl
      eps_eq := fun _ ↦ rfl
    }⟩
  · rintro ⟨T⟩
    exact globularInvTree_isCoindEquiv T

/-! ## Section 3: Nominal Finite-Support Algebra, `FreshChain n`, and `FreshStream` in `Nom` -/

/-- A finite subset `S : Finset ℕ` **supports** `x : X` under `Equiv.Perm ℕ` when every
permutation fixing `S` pointwise fixes `x`. -/
def Supports {X : Type*} [MulAction (Equiv.Perm ℕ) X] (S : Finset ℕ) (x : X) : Prop :=
  ∀ σ ∈ pointwiseStabilizer S, σ • x = x

/-- An element `x : X` has **finite support** in Schanuel's nominal topos `Nom` if it is
supported by some `S : Finset ℕ`. -/
def HasFiniteSupport {X : Type*} [MulAction (Equiv.Perm ℕ) X] (x : X) : Prop :=
  ∃ S : Finset ℕ, Supports S x

/-- An element `x : X` is **globally equivariant** when it is supported by the empty set `∅`
(fixed by all permutations in `Equiv.Perm ℕ`). -/
def IsEquivariant {X : Type*} [MulAction (Equiv.Perm ℕ) X] (x : X) : Prop :=
  Supports ∅ x

/-- Monotonicity of finite supports under subset inclusion. -/
theorem supports_mono {X : Type*} [MulAction (Equiv.Perm ℕ) X]
    {S₁ S₂ : Finset ℕ} (hS : S₁ ⊆ S₂) {x : X} (hx : Supports S₁ x) : Supports S₂ x :=
  fun σ hσ ↦ hx σ (pointwiseStabilizer_antitone hS hσ)

/-- Global equivariance characterizes `Equiv.Perm ℕ`-invariance. -/
theorem isEquivariant_iff_forall {X : Type*} [MulAction (Equiv.Perm ℕ) X] (x : X) :
    IsEquivariant x ↔ ∀ σ : Equiv.Perm ℕ, σ • x = x := by
  simp [IsEquivariant, Supports]

/-- Every globally equivariant element has finite support `∅`. -/
theorem IsEquivariant.hasFiniteSupport {X : Type*} [MulAction (Equiv.Perm ℕ) X] {x : X}
    (hx : IsEquivariant x) : HasFiniteSupport x :=
  ⟨∅, hx⟩

/-- Finite support coincides with openness of the `MulAction.stabilizer` in `Cont(Sym(ℕ))`. -/
theorem hasFiniteSupport_iff_isOpenSubgroup_stabilizer {X : Type*} [MulAction (Equiv.Perm ℕ) X]
    (x : X) : HasFiniteSupport x ↔ IsOpenSubgroup (MulAction.stabilizer (Equiv.Perm ℕ) x) :=
  Iff.rfl

/-- Acting by `g : Equiv.Perm ℕ` pushes support `S` forward to `S.image ⇑g`. -/
theorem supports_smul_image {X : Type*} [MulAction (Equiv.Perm ℕ) X]
    {S : Finset ℕ} {x : X} (hx : Supports S x) (g : Equiv.Perm ℕ) :
    Supports (S.image ⇑g) (g • x) := by
  intro τ hτ
  have hconj : g⁻¹ * τ * g ∈ pointwiseStabilizer S := by
    intro a ha
    have hga : τ (g a) = g a := hτ (g a) (Finset.mem_image_of_mem (⇑g) ha)
    change g⁻¹ (τ (g a)) = a
    rw [hga]
    exact g.symm_apply_apply a
  have hfix : (g⁻¹ * τ * g) • x = x := hx (g⁻¹ * τ * g) hconj
  have hperm : τ * g = g * (g⁻¹ * τ * g) := by
    simp [mul_assoc]
  calc
    τ • (g • x) = (τ * g) • x := (mul_smul τ g x).symm
    _ = (g * (g⁻¹ * τ * g)) • x := by rw [hperm]
    _ = g • ((g⁻¹ * τ * g) • x) := mul_smul g (g⁻¹ * τ * g) x
    _ = g • x := by rw [hfix]

/-- On the atom object `ℕ`, `S` supports `a` if and only if `a ∈ S`. -/
theorem supports_atom_iff (S : Finset ℕ) (a : ℕ) : Supports S a ↔ a ∈ S := by
  constructor
  · intro hS
    by_contra ha
    let b : ℕ := S.sup id + a + 1
    have hb_not_S : b ∉ S := by
      intro hb
      have hle : id b ≤ S.sup id := Finset.le_sup (f := id) hb
      dsimp only [id] at hle
      omega
    have hba : b ≠ a := by omega
    have hmem : Equiv.swap a b ∈ pointwiseStabilizer S := by
      intro x hx
      have hxa : x ≠ a := fun h ↦ ha (h ▸ hx)
      have hxb : x ≠ b := fun h ↦ hb_not_S (h ▸ hx)
      exact Equiv.swap_apply_of_ne_of_ne hxa hxb
    have hfix : Equiv.swap a b • a = a := hS (Equiv.swap a b) hmem
    change Equiv.swap a b a = a at hfix
    rw [Equiv.swap_apply_left] at hfix
    exact hba hfix
  · intro ha σ hσ
    exact hσ a ha

/-- Every individual atom `a : ℕ` has finite support `{a}`. -/
theorem hasFiniteSupport_atom (a : ℕ) : HasFiniteSupport a :=
  ⟨{a}, (supports_atom_iff {a} a).mpr (Finset.mem_singleton_self a)⟩

/-- No individual atom `a : ℕ` is globally equivariant. -/
theorem not_isEquivariant_atom (a : ℕ) : ¬ IsEquivariant a := by
  intro h
  have ha : a ∈ (∅ : Finset ℕ) := (supports_atom_iff ∅ a).mp h
  simp at ha

/-- Finite-depth fresh-atom truncation `FreshChain n` of length `n`, recording `n` pairwise
distinct atoms in `𝔸 = ℕ`. -/
@[ext]
structure FreshChain (n : ℕ) : Type where
  /-- Ordered finite sequence of atoms. -/
  atoms : Fin n → ℕ
  /-- Pairwise distinctness of all atoms in the chain. -/
  injective : Function.Injective atoms

/-- Injectivity of `f : Fin n → ℕ` is equivalent to strict step freshness `j < k → f k ≠ f j`. -/
theorem freshChain_fresh_iff {n : ℕ} (f : Fin n → ℕ) :
    Function.Injective f ↔ ∀ k j : Fin n, j < k → f k ≠ f j := by
  constructor
  · intro hinj k j hjk heq
    exact (ne_of_gt hjk) (hinj heq)
  · intro hfresh j k heq
    rcases lt_trichotomy j k with hlt | rfl | hgt
    · exact absurd heq.symm (hfresh k j hlt)
    · rfl
    · exact absurd heq (hfresh j k hgt)

instance (n : ℕ) : MulAction (Equiv.Perm ℕ) (FreshChain n) where
  smul σ c := ⟨fun i ↦ σ (c.atoms i), σ.injective.comp c.injective⟩
  one_smul c := by
    ext i
    rfl
  mul_smul σ τ c := by
    ext i
    rfl

@[simp]
theorem freshChain_smul_atoms {n : ℕ} (σ : Equiv.Perm ℕ) (c : FreshChain n) (i : Fin n) :
    (σ • c).atoms i = σ (c.atoms i) :=
  rfl

/-- Canonical finite support set of a `FreshChain n`. -/
def FreshChain.supportSet {n : ℕ} (c : FreshChain n) : Finset ℕ :=
  Finset.univ.image c.atoms

/-- The canonical support of a `FreshChain n` has cardinality exactly `n`. -/
@[simp]
theorem FreshChain.card_supportSet {n : ℕ} (c : FreshChain n) : c.supportSet.card = n := by
  unfold FreshChain.supportSet
  rw [Finset.card_image_of_injective _ c.injective, Finset.card_fin]

/-- Every `FreshChain n` is supported by its canonical atom finset `c.supportSet`. -/
theorem supports_freshChain_supportSet {n : ℕ} (c : FreshChain n) :
    Supports c.supportSet c := by
  intro σ hσ
  ext i
  exact hσ (c.atoms i) (Finset.mem_image_of_mem c.atoms (Finset.mem_univ i))

/-- Every finite truncation `FreshChain n` has finite support in `Nom`. -/
theorem hasFiniteSupport_freshChain {n : ℕ} (c : FreshChain n) : HasFiniteSupport c :=
  ⟨c.supportSet, supports_freshChain_supportSet c⟩

/-- Any support `S` of a `FreshChain n` contains `c.supportSet` and hence satisfies `n ≤ S.card`.
-/
theorem card_le_of_supports_freshChain {n : ℕ} {S : Finset ℕ} {c : FreshChain n}
    (hS : Supports S c) : n ≤ S.card := by
  have hsub : c.supportSet ⊆ S := by
    intro a ha
    rcases Finset.mem_image.mp ha with ⟨i, _, rfl⟩
    by_contra hnot
    let b : ℕ := (S ∪ c.supportSet).sup id + 1
    have hbS : b ∉ S := by
      intro hb
      have hle : id b ≤ (S ∪ c.supportSet).sup id :=
        Finset.le_sup (f := id) (Finset.mem_union_left c.supportSet hb)
      dsimp only [id] at hle
      omega
    have hbc : b ∉ c.supportSet := by
      intro hb
      have hle : id b ≤ (S ∪ c.supportSet).sup id :=
        Finset.le_sup (f := id) (Finset.mem_union_right S hb)
      dsimp only [id] at hle
      omega
    have hac : c.atoms i ∈ c.supportSet :=
      Finset.mem_image_of_mem c.atoms (Finset.mem_univ i)
    have hne : c.atoms i ≠ b := fun h ↦ hbc (h ▸ hac)
    have hmem : Equiv.swap (c.atoms i) b ∈ pointwiseStabilizer S := by
      intro x hx
      have hx1 : x ≠ c.atoms i := fun h ↦ hnot (h ▸ hx)
      have hx2 : x ≠ b := fun h ↦ hbS (h ▸ hx)
      exact Equiv.swap_apply_of_ne_of_ne hx1 hx2
    have hfix := congrArg (fun d : FreshChain n ↦ d.atoms i) (hS (Equiv.swap (c.atoms i) b) hmem)
    dsimp only at hfix
    rw [freshChain_smul_atoms, Equiv.swap_apply_left] at hfix
    exact hne hfix.symm
  calc
    n = c.supportSet.card := c.card_supportSet.symm
    _ ≤ S.card := Finset.card_le_card hsub

/-- Canonical `FreshChain n` supported on `Finset.range n`. -/
def canonicalFreshChain (n : ℕ) : FreshChain n where
  atoms := fun i ↦ i.1
  injective := Fin.val_injective

/-- `canonicalFreshChain n` is supported on `Finset.range n`. -/
theorem supports_canonicalFreshChain_range (n : ℕ) :
    Supports (Finset.range n) (canonicalFreshChain n) := by
  intro σ hσ
  ext i
  exact hσ i.1 (Finset.mem_range.mpr i.2)

/-- **Local Splitting at Every Finite Depth `n < ω`:** Any finite support `S` with `n ≤ S.card`
realizes a `S`-supported `FreshChain n`. -/
theorem exists_freshChain_supported_of_card_le {n : ℕ} {S : Finset ℕ} (h : n ≤ S.card) :
    ∃ c : FreshChain n, Supports S c := by
  let e : S ≃ Fin S.card := S.equivFin
  let c : FreshChain n :=
    { atoms := fun i ↦ (e.symm (Fin.castLE h i)).1
      injective := Subtype.val_injective.comp (e.symm.injective.comp (Fin.castLE_injective h)) }
  refine ⟨c, fun σ hσ ↦ ?_⟩
  ext i
  exact hσ (c.atoms i) (e.symm (Fin.castLE h i)).2

instance : Unique (FreshChain 0) where
  default := ⟨Fin.elim0, fun i ↦ i.elim0⟩
  uniq c := by
    ext i
    exact i.elim0

/-- Every depth-`(n + 1)` fresh chain fails global equivariance in `Nom`. -/
theorem not_isEquivariant_freshChain_succ (n : ℕ) (c : FreshChain (n + 1)) :
    ¬ IsEquivariant c := by
  intro hEq
  have hle : n + 1 ≤ (∅ : Finset ℕ).card := card_le_of_supports_freshChain hEq
  simp at hle

/-- Infinite spine of pairwise distinct fresh atoms (`𝔸^{#(ω)}`) in `Nom`. -/
@[ext]
structure FreshStream : Type where
  /-- Infinite sequence of atoms. -/
  atoms : ℕ → ℕ
  /-- Freshness condition: `atoms k` avoids all previously chosen atoms `{atoms 0, ..., atoms (k-1)}`.
  -/
  fresh : ∀ k j : ℕ, j < k → atoms k ≠ atoms j

/-- Every `FreshStream` is an injective sequence of atoms. -/
theorem FreshStream.injective (ξ : FreshStream) : Function.Injective ξ.atoms := by
  intro j k heq
  rcases lt_trichotomy j k with hlt | rfl | hgt
  · exact absurd heq.symm (ξ.fresh k j hlt)
  · rfl
  · exact absurd heq (ξ.fresh j k hgt)

instance : MulAction (Equiv.Perm ℕ) FreshStream where
  smul σ ξ :=
    { atoms := fun k ↦ σ (ξ.atoms k)
      fresh := fun k j hjk heq ↦ ξ.fresh k j hjk (σ.injective heq) }
  one_smul ξ := by
    ext k
    rfl
  mul_smul σ τ ξ := by
    ext k
    rfl

@[simp]
theorem freshStream_smul_atoms (σ : Equiv.Perm ℕ) (ξ : FreshStream) (k : ℕ) :
    (σ • ξ).atoms k = σ (ξ.atoms k) :=
  rfl

/-- Truncates a `FreshStream` to its finite prefix `FreshChain n`. -/
def FreshStream.truncate (n : ℕ) (ξ : FreshStream) : FreshChain n where
  atoms := fun i ↦ ξ.atoms i.1
  injective := ξ.injective.comp Fin.val_injective

/-- Truncation `FreshStream.truncate n` is `Equiv.Perm ℕ`-equivariant. -/
theorem FreshStream.truncate_smul (n : ℕ) (σ : Equiv.Perm ℕ) (ξ : FreshStream) :
    (σ • ξ).truncate n = σ • ξ.truncate n :=
  rfl

/-- **Explicit Transposition Obstruction for `FreshStream`:** Over any finite support `S`, every
`FreshStream` contains an atom `ξ.atoms m ∉ S` which can be swapped with a fresh atom `b ∉ S`
by a stabilizer permutation in `pointwiseStabilizer S`, moving `ξ`. -/
theorem exists_swap_stabilizer_ne_on_freshStream (ξ : FreshStream) (S : Finset ℕ) :
    ∃ m b : ℕ,
      ξ.atoms m ∉ S ∧
      b ∉ S ∧
      b ≠ ξ.atoms m ∧
      Equiv.swap (ξ.atoms m) b ∈ pointwiseStabilizer S ∧
      Equiv.swap (ξ.atoms m) b • ξ ≠ ξ := by
  let T : Finset ℕ := (Finset.range (S.card + 1)).image ξ.atoms
  have hcard : T.card = S.card + 1 := by
    unfold T
    rw [Finset.card_image_of_injective _ ξ.injective, Finset.card_range]
  have hnot_sub : ¬ T ⊆ S := by
    intro hsub
    have hle : T.card ≤ S.card := Finset.card_le_card hsub
    omega
  obtain ⟨a, haT, haS⟩ := Finset.not_subset.mp hnot_sub
  obtain ⟨m, _, rfl⟩ := Finset.mem_image.mp haT
  let b : ℕ := S.sup id + ξ.atoms m + 1
  have hbS : b ∉ S := by
    intro hb
    have hle : id b ≤ S.sup id := Finset.le_sup (f := id) hb
    dsimp only [id] at hle
    omega
  have hbm : b ≠ ξ.atoms m := by omega
  have hmem : Equiv.swap (ξ.atoms m) b ∈ pointwiseStabilizer S := by
    intro x hx
    have hxm : x ≠ ξ.atoms m := fun h ↦ haS (h ▸ hx)
    have hxb : x ≠ b := fun h ↦ hbS (h ▸ hx)
    exact Equiv.swap_apply_of_ne_of_ne hxm hxb
  have hne : Equiv.swap (ξ.atoms m) b • ξ ≠ ξ := by
    intro heq
    have hm := congrArg (fun ζ : FreshStream ↦ ζ.atoms m) heq
    dsimp only at hm
    rw [freshStream_smul_atoms, Equiv.swap_apply_left] at hm
    exact hbm hm
  exact ⟨m, b, haS, hbS, hbm, hmem, hne⟩

/-- No infinite fresh stream `ξ : FreshStream` has finite support in `Nom`. -/
theorem not_hasFiniteSupport_freshStream (ξ : FreshStream) : ¬ HasFiniteSupport ξ := by
  rintro ⟨S, hS⟩
  rcases exists_swap_stabilizer_ne_on_freshStream ξ S with ⟨_, _, _, _, _, hmem, hne⟩
  exact hne (hS _ hmem)

/-- Global nominal sections of `FreshStream` are empty (`IsEmpty`). -/
theorem isEmpty_finitelySupported_freshStream :
    IsEmpty {ξ : FreshStream // HasFiniteSupport ξ} :=
  ⟨fun ⟨ξ, hξ⟩ ↦ not_hasFiniteSupport_freshStream ξ hξ⟩

/-! ## Section 4: Fresh-Atom Computad Spine `E[𝔸]` & Unified Theorem 9B -/

/-- Cell spine in the internal fresh-atom computad `Free_CaTT(E[𝔸])`: a finite duplicate-free
list of atoms encoding the accumulated cancellation context. -/
@[ext]
structure FreshCell : Type where
  /-- Accumulated finite sequence of fresh atoms along the cancellation branch. -/
  spine : List ℕ
  /-- Duplicate-free invariant on the accumulated atom context. -/
  nodup : spine.Nodup

/-- Canonical equivariant root cell `FreshCell.root` with empty spine `[]`. -/
def FreshCell.root : FreshCell where
  spine := []
  nodup := List.nodup_nil

/-- Single-atom cell `FreshCell.singleton a` with spine `[a]`. -/
def FreshCell.singleton (a : ℕ) : FreshCell where
  spine := [a]
  nodup := List.nodup_singleton a

instance : MulAction (Equiv.Perm ℕ) FreshCell where
  smul σ c := ⟨c.spine.map ⇑σ, c.nodup.map σ.injective⟩
  one_smul c := by
    apply FreshCell.ext
    change c.spine.map ⇑(1 : Equiv.Perm ℕ) = c.spine
    simp [Equiv.Perm.coe_one]
  mul_smul σ τ c := by
    apply FreshCell.ext
    change c.spine.map ⇑(σ * τ) = (c.spine.map ⇑τ).map ⇑σ
    simp [Equiv.Perm.coe_mul, List.map_map, Function.comp_def]

@[simp]
theorem freshCell_smul_spine (σ : Equiv.Perm ℕ) (c : FreshCell) :
    (σ • c).spine = c.spine.map ⇑σ :=
  rfl

@[simp]
theorem smul_freshCell_root (σ : Equiv.Perm ℕ) : σ • FreshCell.root = FreshCell.root := by
  ext1
  rfl

/-- `FreshCell.root` is globally equivariant in `Nom`. -/
theorem isEquivariant_freshCell_root : IsEquivariant FreshCell.root :=
  fun σ _ ↦ smul_freshCell_root σ

private theorem list_map_eq_self_of_forall {α : Type*} (f : α → α) :
    ∀ l : List α, (∀ a ∈ l, f a = a) → l.map f = l
  | [], _ => rfl
  | hd :: tl, h => by
    have hhd : f hd = hd := h hd List.mem_cons_self
    have htl : tl.map f = tl := list_map_eq_self_of_forall f tl (fun a ha ↦ h a (List.mem_cons_of_mem hd ha))
    simp [hhd, htl]

/-- Every `FreshCell` has finite support `c.spine.toFinset` in `Nom`. -/
theorem hasFiniteSupport_freshCell (c : FreshCell) : HasFiniteSupport c := by
  refine ⟨c.spine.toFinset, fun σ hσ ↦ ?_⟩
  ext1
  change c.spine.map ⇑σ = c.spine
  exact list_map_eq_self_of_forall (⇑σ) c.spine (fun a ha ↦ hσ a (List.mem_toFinset.mpr ha))

/-- No singleton cell `FreshCell.singleton a` is globally equivariant. -/
theorem not_isEquivariant_freshCell_singleton (a : ℕ) :
    ¬ IsEquivariant (FreshCell.singleton a) := by
  intro hEq
  have hmem : Equiv.swap a (a + 1) ∈ pointwiseStabilizer (∅ : Finset ℕ) := by
    intro _ hx
    simp at hx
  have hfix := congrArg FreshCell.spine (hEq (Equiv.swap a (a + 1)) hmem)
  simp [FreshCell.singleton, Equiv.swap_apply_left] at hfix

/-- Equivariant 1-step fresh cancellation transition `FreshComputadStep` on `FreshCell`: advances
the diagonal pair `(x, x)` to `(p, p)` by appending a fresh atom `a ∉ x.spine`. -/
def FreshComputadStep (x y p q : FreshCell) : Prop :=
  x = y ∧ p = q ∧ ∃ a : ℕ, a ∉ x.spine ∧ p.spine = x.spine ++ [a]

/-- Diagonal relational fixed point `FreshDiagRel` on `FreshCell`. -/
def FreshDiagRel (x y : FreshCell) : Prop :=
  x = y

/-- `FreshComputadStep` is `Equiv.Perm ℕ`-equivariant in `Nom`. -/
theorem freshComputadStep_smul (σ : Equiv.Perm ℕ) {x y p q : FreshCell}
    (h : FreshComputadStep x y p q) :
    FreshComputadStep (σ • x) (σ • y) (σ • p) (σ • q) := by
  rcases h with ⟨rfl, rfl, a, ha, hp⟩
  refine ⟨rfl, rfl, σ a, ?_, ?_⟩
  · intro hmem
    rw [freshCell_smul_spine, List.mem_map] at hmem
    rcases hmem with ⟨b, hb, hba⟩
    exact ha (σ.injective hba ▸ hb)
  · simp [hp]

private theorem mem_le_foldr_max : ∀ (l : List ℕ) {b : ℕ}, b ∈ l → b ≤ l.foldr max 0
  | [], _, hb => by simp at hb
  | hd :: tl, b, hb => by
    simp only [List.mem_cons] at hb
    rcases hb with rfl | htl
    · exact le_max_left _ _
    · exact le_trans (mem_le_foldr_max tl htl) (le_max_right _ _)

/-- Every diagonal pair `(x, x)` in `FreshDiagRel` admits a valid fresh extension step. -/
theorem isStepSound_freshDiagRel : IsStepSound FreshComputadStep FreshDiagRel := by
  intro x y hxy
  subst hxy
  let a : ℕ := x.spine.foldr max 0 + 1
  have ha_not : a ∉ x.spine := by
    intro ha
    have hle := mem_le_foldr_max x.spine ha
    omega
  have hnodup : (x.spine ++ [a]).Nodup := by
    rw [List.nodup_append]
    exact ⟨x.nodup, List.nodup_singleton a, fun b hb c hc hbc ↦ by
      simp only [List.mem_singleton] at hc
      subst hc
      subst hbc
      exact ha_not hb⟩
  let p : FreshCell := ⟨x.spine ++ [a], hnodup⟩
  exact ⟨p, p, ⟨rfl, rfl, a, ha_not, rfl⟩, rfl⟩

/-- Internal coinductive witness streams rooted at `FreshCell.root` over `E[𝔸]`. -/
abbrev FreshRootStream :=
  InvStream FreshComputadStep FreshDiagRel FreshCell.root FreshCell.root

instance : MulAction (Equiv.Perm ℕ) FreshRootStream where
  smul σ s :=
    { pair := fun n ↦ (σ • (s.pair n).1, σ • (s.pair n).2)
      zero_eq := by
        rw [s.zero_eq]
        simp
      rel_mem := fun n ↦ by
        change σ • (s.pair n).1 = σ • (s.pair n).2
        rw [s.rel_mem n]
      step_valid := fun n ↦ freshComputadStep_smul σ (s.step_valid n) }
  one_smul s := by
    apply InvStream.ext
    funext n
    exact Prod.ext (one_smul (Equiv.Perm ℕ) (s.pair n).1) (one_smul (Equiv.Perm ℕ) (s.pair n).2)
  mul_smul σ τ s := by
    apply InvStream.ext
    funext n
    exact Prod.ext (mul_smul σ τ (s.pair n).1) (mul_smul σ τ (s.pair n).2)

@[simp]
theorem freshRootStream_smul_pair (σ : Equiv.Perm ℕ) (s : FreshRootStream) (n : ℕ) :
    (σ • s).pair n = (σ • (s.pair n).1, σ • (s.pair n).2) :=
  rfl

private theorem freshRootStream_step_append (s : FreshRootStream) (n : ℕ) :
    ∃ a : ℕ, a ∉ (s.pair n).1.spine ∧ (s.pair (n + 1)).1.spine = (s.pair n).1.spine ++ [a] :=
  (s.step_valid n).2.2

private theorem freshRootStream_spine_length (s : FreshRootStream) (n : ℕ) :
    (s.pair n).1.spine.length = n := by
  induction n with
  | zero =>
    rw [s.zero_eq]
    rfl
  | succ k ih =>
    rcases freshRootStream_step_append s k with ⟨a, _, ha⟩
    rw [ha, List.length_append, List.length_singleton, ih]

private theorem freshRootStream_spine_prefix (s : FreshRootStream) {j k : ℕ} (hjk : j ≤ k) :
    (s.pair j).1.spine <+: (s.pair k).1.spine := by
  induction hjk with
  | refl => exact List.prefix_rfl
  | @step m _ ih =>
    rcases freshRootStream_step_append s m with ⟨a, _, ha⟩
    have hstep : (s.pair m).1.spine <+: (s.pair (m + 1)).1.spine := ⟨[a], ha.symm⟩
    exact ih.trans hstep

/-- Extracts the `k`-th fresh atom chosen along a `FreshRootStream`. -/
def FreshRootStream.atomAt (s : FreshRootStream) (k : ℕ) : ℕ :=
  (s.pair (k + 1)).1.spine[k]'(by rw [freshRootStream_spine_length]; omega)

/-- Equivariant extraction of an infinite fresh atom stream `FreshStream` from any
`FreshRootStream`. -/
def FreshRootStream.toFreshStream (s : FreshRootStream) : FreshStream where
  atoms := s.atomAt
  fresh := by
    intro k j hjk
    have hklen : k < (s.pair (k + 1)).1.spine.length := by
      rw [freshRootStream_spine_length]; omega
    have hjlen_j : j < (s.pair (j + 1)).1.spine.length := by
      rw [freshRootStream_spine_length]; omega
    have hjlen_k : j < (s.pair (k + 1)).1.spine.length := by
      rw [freshRootStream_spine_length]; omega
    obtain ⟨t, ht⟩ := freshRootStream_spine_prefix s (Nat.succ_le_succ (Nat.le_of_lt hjk))
    have hget_j : (s.pair (k + 1)).1.spine[j]'hjlen_k = s.atomAt j := by
      unfold FreshRootStream.atomAt
      calc
        (s.pair (k + 1)).1.spine[j]'hjlen_k
            = ((s.pair (j + 1)).1.spine ++ t)[j]'(by rw [ht]; exact hjlen_k) := by
              congr 1
              exact ht.symm
        _ = (s.pair (j + 1)).1.spine[j]'hjlen_j :=
              List.getElem_append_left hjlen_j
    intro heq
    have heq' : (s.pair (k + 1)).1.spine[k]'hklen = (s.pair (k + 1)).1.spine[j]'hjlen_k := by
      simpa [FreshRootStream.atomAt, hget_j] using heq
    have hidx : k = j := (s.pair (k + 1)).1.nodup.getElem_inj_iff.mp heq'
    omega

/-- `FreshRootStream.toFreshStream` is strictly `Equiv.Perm ℕ`-equivariant. -/
theorem FreshRootStream.toFreshStream_smul (σ : Equiv.Perm ℕ) (s : FreshRootStream) :
    (σ • s).toFreshStream = σ • s.toFreshStream := by
  ext k
  change (σ • s).atomAt k = σ (s.atomAt k)
  unfold FreshRootStream.atomAt
  simp only [freshRootStream_smul_pair, freshCell_smul_spine, List.getElem_map]

/-- No `FreshRootStream` has finite support in `Nom`. -/
theorem not_hasFiniteSupport_freshRootStream (s : FreshRootStream) : ¬ HasFiniteSupport s := by
  rintro ⟨S, hS⟩
  have hS_stream : Supports S s.toFreshStream := by
    intro σ hσ
    rw [← FreshRootStream.toFreshStream_smul, hS σ hσ]
  exact not_hasFiniteSupport_freshStream s.toFreshStream ⟨S, hS_stream⟩

/-- The nominal object of finitely supported coinductive witness streams over `E[𝔸]` is empty.
-/
theorem isEmpty_nominal_freshRootStream :
    IsEmpty {s : FreshRootStream // HasFiniteSupport s} :=
  ⟨fun ⟨s, hs⟩ ↦ not_hasFiniteSupport_freshRootStream s hs⟩

/-- **Theorem 9B (`Choice Calibration of Internal Coinductive Invertibility Streams`, Ch. 6 §6.8):**
1. **Classical `DC_ω` Adequacy (`Rung ≥ 1`):** For any step-sound relation, `InvStream.toRel` is
   surjective, and `FreshRootStream` is inhabited over `FreshCell.root`.
2. **Equivariant Fixed-Point Inhabitation (`Nom`, `Rung 0`):** `FreshCell.root` is globally
   equivariant inside the step-sound diagonal fixed point `FreshDiagRel`.
3. **Finite-Depth Nominal Splitting (`n < ω`):** Every finite truncation `FreshChain n` splits
   locally over `Finset.range n`.
4. **Global Nominal Stream Failure (`E[𝔸]`):** No `FreshRootStream` has finite support, so
   `InvStr_1(Free_CaTT(E[𝔸]))_root = ∅` while `root ∈ Γ(E_rel,1)`. -/
theorem theorem9B_choice_calibration_of_coinductive_streams :
    Function.Surjective
        (InvStream.toRel (Step := FreshComputadStep) (R := FreshDiagRel)) ∧
      Nonempty FreshRootStream ∧
      (IsEquivariant FreshCell.root ∧
        FreshDiagRel FreshCell.root FreshCell.root ∧
        IsStepSound FreshComputadStep FreshDiagRel) ∧
      (∀ n : ℕ, ∃ c : FreshChain n, Supports (Finset.range n) c) ∧
      IsEmpty {s : FreshRootStream // HasFiniteSupport s} := by
  refine ⟨surjective_toRel_of_stepSound isStepSound_freshDiagRel, ?_, ?_, ?_, ?_⟩
  · exact ⟨buildInvStreamOfStepSound isStepSound_freshDiagRel rfl⟩
  · exact ⟨isEquivariant_freshCell_root, rfl, isStepSound_freshDiagRel⟩
  · exact fun n ↦ ⟨canonicalFreshChain n, supports_canonicalFreshChain_range n⟩
  · exact isEmpty_nominal_freshRootStream

/-! ## Section 5: Mandatory 4-Layer Definition Check Gate (`namespace Checks`) -/

namespace Checks

/-! ### Layer 1: Carrier Inhabitation (`Nontrivial` Instances) -/

/-- Layer 1 instance: `FreshChain 1` is `Nontrivial`. -/
instance icatt_instNontrivialFreshChainOne : Nontrivial (FreshChain 1) := by
  refine ⟨⟨canonicalFreshChain 1,
    ⟨fun _ ↦ 1, fun i j _ ↦ Subsingleton.elim i j⟩, fun h ↦ ?_⟩⟩
  have h0 := congrArg (fun c : FreshChain 1 ↦ c.atoms 0) h
  simp [canonicalFreshChain] at h0

/-- Layer 1 instance: `FreshStream` is `Nontrivial`. -/
instance icatt_instNontrivialFreshStream : Nontrivial FreshStream := by
  let s0 : FreshStream := ⟨fun k ↦ k, fun _ _ hjk heq ↦ Nat.ne_of_gt hjk heq⟩
  let s1 : FreshStream := ⟨fun k ↦ k + 1, fun _ _ hjk heq ↦ Nat.ne_of_gt hjk (Nat.succ.inj heq)⟩
  refine ⟨⟨s0, s1, fun h ↦ ?_⟩⟩
  have h0 := congrArg (fun ξ : FreshStream ↦ ξ.atoms 0) h
  simp [s0, s1] at h0

/-- Layer 1 instance: `FreshCell` is `Nontrivial` (`FreshCell.root ≠ FreshCell.singleton 0`). -/
instance icatt_instNontrivialFreshCell : Nontrivial FreshCell := by
  refine ⟨⟨FreshCell.root, FreshCell.singleton 0, fun h ↦ ?_⟩⟩
  have hs := congrArg FreshCell.spine h
  simp [FreshCell.root, FreshCell.singleton] at hs

/-- Concrete offset stream constructor used for Layer 1 non-degeneracy of `FreshRootStream`. -/
private def offsetFreshRootStream (offset : ℕ) : FreshRootStream where
  pair n :=
    let l : List ℕ := (List.range n).map (· + offset)
    let hn : l.Nodup := List.nodup_range.map (fun a b hab ↦ by omega)
    (⟨l, hn⟩, ⟨l, hn⟩)
  zero_eq := by
    ext1 <;> rfl
  rel_mem _ := rfl
  step_valid n := by
    refine ⟨rfl, rfl, n + offset, ?_, ?_⟩
    · simp only [List.mem_map, List.mem_range]
      rintro ⟨k, hk, hkeq⟩
      omega
    · simp [List.range_succ, List.map_append]

/-- Layer 1 instance: `FreshRootStream` is `Nontrivial` (distinct offset atom spines). -/
instance icatt_instNontrivialFreshRootStream : Nontrivial FreshRootStream := by
  refine ⟨⟨offsetFreshRootStream 0, offsetFreshRootStream 1, fun h ↦ ?_⟩⟩
  have h1 := congrArg (fun s : FreshRootStream ↦ (s.pair 1).1.spine) h
  simp [offsetFreshRootStream] at h1

/-- Explicit constructive witness `GlobularInvTree coindArrow` in `CoindWalkState`. -/
def coindArrowInvTree : GlobularInvTree coindArrow where
  node _ := ⟨CoindWalkState.loop, false, true, coindArrow⟩
  step _ := { inv := (), eta := (), eps := () }
  root_eq := rfl
  eta_eq _ := rfl
  eps_eq _ := rfl

/-- Minimal 1-state `GlobularInfSystem` over `Unit` whose morphisms are `Bool`, providing a
non-trivial `GlobularInvTree` space (`inv = false` vs. `inv = true`). -/
private def dualInvSys : GlobularInfSystem Unit where
  Obj _ := Bool
  hom _ _ := ()
  idMor _ := true
  compMor _ _ := true
  id_comp_id _ := rfl

/-- Layer 1 non-degeneracy: `GlobularInvTree` admits distinct inhabited trees (`T₁ ≠ T₂`). -/
theorem icatt_globularInvTree_nontrivial :
    letI : GlobularInfSystem Unit := dualInvSys
    ∃ T₁ T₂ : GlobularInvTree (s := ()) (x := true) (y := true) false, T₁ ≠ T₂ := by
  letI : GlobularInfSystem Unit := dualInvSys
  let rootCell : GlobularCell Unit := ⟨(), true, true, false⟩
  let trueCell : GlobularCell Unit := ⟨(), true, true, true⟩
  let mkTree (invChoice : Bool) : GlobularInvTree (s := ()) (x := true) (y := true) false :=
    { node := fun p ↦ match p with
        | [] => rootCell
        | _ :: _ => trueCell
      step := fun p ↦ match p with
        | [] => { inv := invChoice, eta := true, eps := true }
        | _ :: _ => { inv := true, eta := true, eps := true }
      root_eq := rfl
      eta_eq := fun p ↦ by cases p <;> rfl
      eps_eq := fun p ↦ by cases p <;> rfl }
  refine ⟨mkTree false, mkTree true, fun h ↦ ?_⟩
  have hinv := congrArg (fun T : GlobularInvTree (s := ()) (x := true) (y := true) false ↦
    (T.step []).inv) h
  simp [mkTree] at hinv

/-! ### Layer 2: Bidirectional Separation -/

/-- Layer 2 negative witness for `IsStepSound`: a dead-end step relation `False` fails `IsStepSound`
on `Eq`. -/
theorem icatt_not_isStepSound_deadStep :
    ¬ IsStepSound (fun _ _ _ _ : Unit ↦ False) Eq := by
  intro h
  rcases h () () rfl with ⟨_, _, hfalse, _⟩
  exact hfalse

/-- Layer 2 bidirectional separation for `IsStepSound`: `FreshDiagRel` is step-sound while the
dead-end relation on `Unit` is not. -/
theorem icatt_layer2_sep_isStepSound :
    IsStepSound FreshComputadStep FreshDiagRel ∧
      ¬ IsStepSound (fun _ _ _ _ : Unit ↦ False) Eq :=
  ⟨isStepSound_freshDiagRel, icatt_not_isStepSound_deadStep⟩

/-- Sequence carrier `ℕ → ℕ` equipped with pointwise `Equiv.Perm ℕ`-action for Layer 2
finite-support separation. -/
@[ext]
structure AtomValSeq : Type where
  /-- Sequence value at index `n : ℕ`. -/
  val : ℕ → ℕ

instance : MulAction (Equiv.Perm ℕ) AtomValSeq where
  smul σ f := ⟨fun n ↦ σ (f.val n)⟩
  one_smul f := by ext n; rfl
  mul_smul σ τ f := by ext n; rfl

/-- Layer 2 positive witness for `HasFiniteSupport`: the constant sequence `0` is supported on
`{0}`. -/
theorem icatt_hasFiniteSupport_atomValSeq_const :
    HasFiniteSupport (⟨fun _ ↦ 0⟩ : AtomValSeq) := by
  refine ⟨{0}, fun σ hσ ↦ ?_⟩
  ext n
  exact hσ 0 (Finset.mem_singleton_self 0)

/-- Layer 2 negative counter-witness for `HasFiniteSupport`: the identity sequence `fun n ↦ n`
lacks finite support in `Nom`. -/
theorem icatt_not_hasFiniteSupport_atomValSeq_id :
    ¬ HasFiniteSupport (⟨fun n ↦ n⟩ : AtomValSeq) := by
  rintro ⟨S, hS⟩
  let a : ℕ := S.sup id + 1
  let b : ℕ := a + 1
  have haS : a ∉ S := by
    intro ha
    have hle : id a ≤ S.sup id := Finset.le_sup (f := id) ha
    dsimp only [id] at hle
    omega
  have hbS : b ∉ S := by
    intro hb
    have hle : id b ≤ S.sup id := Finset.le_sup (f := id) hb
    dsimp only [id] at hle
    omega
  have hmem : Equiv.swap a b ∈ pointwiseStabilizer S := by
    intro x hx
    exact Equiv.swap_apply_of_ne_of_ne (fun h ↦ haS (h ▸ hx)) (fun h ↦ hbS (h ▸ hx))
  have hfix := congrArg (fun f : AtomValSeq ↦ f.val a) (hS (Equiv.swap a b) hmem)
  change Equiv.swap a b a = a at hfix
  rw [Equiv.swap_apply_left] at hfix
  omega

/-- Layer 2 bidirectional separation for `IsEquivariant` on `FreshCell`: `FreshCell.root` is
equivariant, while `FreshCell.singleton 0` has finite support `{0}` yet fails equivariance. -/
theorem icatt_layer2_sep_isEquivariant_freshCell :
    IsEquivariant FreshCell.root ∧
      (HasFiniteSupport (FreshCell.singleton 0) ∧ ¬ IsEquivariant (FreshCell.singleton 0)) :=
  ⟨isEquivariant_freshCell_root,
    ⟨hasFiniteSupport_freshCell (FreshCell.singleton 0), not_isEquivariant_freshCell_singleton 0⟩⟩

/-- Every `FreshChain 0` is globally equivariant. -/
theorem isEquivariant_freshChain_zero (c : FreshChain 0) : IsEquivariant c := by
  intro σ _
  exact Subsingleton.elim _ _

/-- Layer 2 bidirectional separation for `IsEquivariant` on `FreshChain`: depth `0` is globally
equivariant while depth `1` (`canonicalFreshChain 1`) is supported on `{0}` yet non-equivariant. -/
theorem icatt_layer2_sep_freshChain_equivariant :
    IsEquivariant (canonicalFreshChain 0) ∧
      (Supports (Finset.range 1) (canonicalFreshChain 1) ∧
        ¬ IsEquivariant (canonicalFreshChain 1)) :=
  ⟨isEquivariant_freshChain_zero (canonicalFreshChain 0),
    ⟨supports_canonicalFreshChain_range 1,
      not_isEquivariant_freshChain_succ 0 (canonicalFreshChain 1)⟩⟩

/-- Layer 2 bidirectional separation between `Set` (`DC_ω`) and `Nom` (`HasFiniteSupport`) on
`FreshRootStream`. -/
theorem icatt_layer2_sep_set_vs_nom_freshRootStream :
    Nonempty FreshRootStream ∧ IsEmpty {s : FreshRootStream // HasFiniteSupport s} :=
  ⟨⟨offsetFreshRootStream 0⟩, isEmpty_nominal_freshRootStream⟩

/-- Layer 2 bidirectional separation on `CoindWalkState.coindArrow`: inhabited coinductive tree
vs. non-inductive equivalence (`¬ IsEquiv coindArrow`). -/
theorem icatt_layer2_sep_coindArrow_tree_vs_isEquiv :
    Nonempty (GlobularInvTree coindArrow) ∧ ¬ IsEquiv coindArrow :=
  ⟨⟨coindArrowInvTree⟩, coindArrow_not_isEquiv⟩

