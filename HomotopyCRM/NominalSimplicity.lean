/-- Derived sanity lemma 2: Čech 1-cocycle identity `(s_a -ᵥ s_b) + (s_b -ᵥ s_c) = s_a -ᵥ s_c` in
`EvenFinset` across any triple of 1-atom local sections `{a}`, `{b}`, `{c}`. -/
theorem derived_cech_cocycle_atomSection (a b c : ℕ) :
    (atomSection a -ᵥ atomSection b) + (atomSection b -ᵥ atomSection c) =
      atomSection a -ᵥ atomSection c :=
  vsub_add_vsub_cancel (atomSection a) (atomSection b) (atomSection c)

/-- Derived sanity lemma 3: concrete Čech cocycle evaluation on `{0}`, `{1}`, `{2}` verifying
`{0, 1} ∆ {1, 2} = {0, 2}` in `EvenFinset`. -/
theorem derived_cech_cocycle_012_val :
    ((atomSection 0 -ᵥ atomSection 1) + (atomSection 1 -ᵥ atomSection 2)).1 =
      ({0, 2} : Finset ℕ) := by
  rw [derived_cech_cocycle_atomSection]
  exact atomSection_vsub_val_of_ne (by decide : (0 : ℕ) ≠ 2)

