/-!
# Pro-Discrete Blindness and the Parity Torsor in Schanuel's Topos `Cont(Sym(ℕ))`

This module formalizes `MSG_008` (`TODO-08`) of the `HomotopyCRM` library, establishing the
topological-group and sheaf-cohomological residuum structure of Schanuel's permutation topos
`Nom ≃ Cont(Sym(ℕ))` (where `Sym(ℕ) = Equiv.Perm ℕ` carries the pointwise-convergence topology
generated by finite-support pointwise stabilizers `pointwiseStabilizer F`):

1. **Finite-Support Topology & Guardrail 5 External-Projectivity Obstruction:**
   - `pointwiseStabilizer F : Subgroup (Equiv.Perm ℕ)` consists of permutations fixing every atom
     `a ∈ F`, and `IsOpenSubgroup H` holds when `pointwiseStabilizer F ≤ H` for some `F : Finset ℕ`.
   - **Mathematical Red-Team Guardrail 5 (`AGENTS.md` §2.5):** Although `Cont(Sym(ℕ))` is an
     atomic, two-valued (`Sub(1) = {0, 1}`), Boolean Grothendieck topos satisfying Small Violations
     of Choice (`SVC`), its terminal object `1` is **not** externally projective: for every
     non-empty finite support `F`, `pointwiseStabilizer F < ⊤` is a proper open subgroup and the
     inhabited homogeneous coset object `Equiv.Perm ℕ ⧸ pointwiseStabilizer F` has **empty global
     sections** (`IsEmpty {x : Equiv.Perm ℕ ⧸ pointwiseStabilizer F // ∀ g, g • x = x}`). More
     generally, for any group `G` and proper subgroup `U < ⊤`, `(G ⧸ U)^G` is empty
     (`isEmpty_globalSections_quotient_of_lt_top`), reflecting the collapse of external
     projectivity of `1`, localicity, `COSHEP`, `IAC`, and `AC` in two-valued atomic permutation
     topoi `Cont(G)` to `U(G) = {G}` (`Cont(G) ≃ Set`).

2. **Open Normal Subgroup Triviality & Pro-Discrete Blindness Over `pointwiseStabilizer F`:**
   - **Theorem 1 (`open_normal_eq_top`):** Every open normal subgroup `N` of `Equiv.Perm ℕ` is
     improper (`N = ⊤`). Consequently, `H¹_Nom(1, ΔG) = 0` for every discrete group `G`.
   - **Theorem 2 (`open_normal_in_stabilizer_eq`, `open_finiteRelIndex_eq_stabilizer`):** Via the
     topological-group isomorphism `pointwiseStabilizer F ≃* Equiv.Perm {n : ℕ // n ∉ F} ≃*
     Equiv.Perm ℕ` (`stabilizerMulEquivPermNat F`) and finite-intersection openness of the normal
     core (`isOpenSubgroup_normalCore`), `pointwiseStabilizer F` admits **no proper open normal
     subgroups** and **no proper finite-index open subgroups** (`H¹_Nom(y(F), ΔG) = 0` and every
     internal finite-fiber epimorphism over any representable pointwise-stabilizer slice `y(F)`
     splits externally, validating `FAC_k` on all representable slices `y(F)` of `Cont(Sym(ℕ))`
     while non-representable slices such as `[𝔸]^2` refute `IFAC_2`).

3. **The `ZMod 2` Even-`Finset` Sheaf `EvenFinset` & Odd-Parity Torsor `T_odd`:**
   - `EvenFinset := {S : Finset ℕ // Even S.card}` forms an `AddCommGroup` and `Module (ZMod 2)`
     under symmetric difference `∆` (`S ∆ S = ∅`, so `2 • E = 0`) with continuous `Equiv.Perm ℕ`
     action (`DistribMulAction (Equiv.Perm ℕ) EvenFinset`).
   - `T_odd := {S : Finset ℕ // Odd S.card}` (characterized modulo `2` by `(S.card : ZMod 2) = 1`)
     forms an `Equiv.Perm ℕ`-equivariant `AddTorsor EvenFinset T_odd` with empty global sections
     over `∅` (`isEmpty_t_odd_sections_empty`), canonical local trivializations `atomSection a =
     ⟨{a}, _⟩` over every 1-atom support `{a}` (`nonempty_t_odd_sections_singleton`), and non-zero
     even-cardinality Čech coboundary `(atomSection a -ᵥ atomSection b).1 = {a} ∆ {b} = {a, b}` of
     cardinality `2` for `a ≠ b` (`atomSection_vsub_val_of_ne`), witnessing a ramified internal
     sheaf torsor `[T_odd] ≠ 0 ∈ H¹_Nom(1, EvenFinset)` invisible to pro-discrete Galois pullbacks.

4. **Mandatory 4-Layer Definition Check Gate (`namespace Checks`):**
   - Verifies Inhabitation (Layer 1), Bidirectional Separation across all core predicates including
     a non-trivial non-open closed parity subgroup (Layer 2), Mathlib projections & derived Čech
     cocycle/continuity lemmas (Layer 3), and `#guard_msgs in #print axioms` (Layer 4).
-/

namespace HomotopyCRM

open scoped Pointwise symmDiff

/-! ## Section 1: Finite-Support Topology on `Equiv.Perm ℕ` and Guardrail 5 -/

/-- The **pointwise stabilizer** `G_(F)` of a finite support `F : Finset ℕ` in `Equiv.Perm ℕ`,
consisting of all permutations fixing every atom `a ∈ F`. -/
def pointwiseStabilizer (F : Finset ℕ) : Subgroup (Equiv.Perm ℕ) where
  carrier := {σ : Equiv.Perm ℕ | ∀ a ∈ F, σ a = a}
  mul_mem' {σ τ} hσ hτ a ha := by
    change σ (τ a) = a
    rw [hτ a ha, hσ a ha]
  one_mem' _ _ := rfl
  inv_mem' {σ} hσ a ha := by
    have h := congrArg (⇑σ⁻¹) (hσ a ha)
    simpa using h.symm

@[simp]
theorem mem_pointwiseStabilizer {F : Finset ℕ} {σ : Equiv.Perm ℕ} :
    σ ∈ pointwiseStabilizer F ↔ ∀ a ∈ F, σ a = a :=
  Iff.rfl

/-- Over the empty support `∅`, the pointwise stabilizer is the full group `⊤`. -/
@[simp]
theorem pointwiseStabilizer_empty : pointwiseStabilizer ∅ = ⊤ := by
  ext σ
  simp

/-- Enlarging the finite support `F₁ ⊆ F₂` shrinks the pointwise stabilizer. -/
theorem pointwiseStabilizer_antitone : Antitone pointwiseStabilizer := by
  intro F₁ F₂ hF σ hσ a ha
  exact hσ a (hF ha)

/-- Binary intersection of basic open stabilizers corresponds to union of finite supports. -/
theorem pointwiseStabilizer_union (F₁ F₂ : Finset ℕ) :
    pointwiseStabilizer (F₁ ∪ F₂) = pointwiseStabilizer F₁ ⊓ pointwiseStabilizer F₂ := by
  ext σ
  simp only [mem_pointwiseStabilizer, Finset.mem_union, Subgroup.mem_inf]
  exact ⟨fun h ↦ ⟨fun a ha ↦ h a (Or.inl ha), fun a ha ↦ h a (Or.inr ha)⟩,
    fun ⟨h₁, h₂⟩ a ha ↦ ha.elim (h₁ a) (h₂ a)⟩

/-- Conjugating `pointwiseStabilizer F` by `g : Equiv.Perm ℕ` shifts the support to `F.image ⇑g`.
-/
theorem conj_pointwiseStabilizer (g : Equiv.Perm ℕ) (F : Finset ℕ) :
    MulAut.conj g • pointwiseStabilizer F = pointwiseStabilizer (F.image ⇑g) := by
  ext τ
  rw [Subgroup.mem_pointwise_smul_iff_inv_smul_mem]
  simp only [← map_inv, MulAut.smul_def, MulAut.conj_apply, mem_pointwiseStabilizer,
    Finset.mem_image, Equiv.Perm.coe_mul, Function.comp_apply, Equiv.Perm.inv_def]
  constructor
  · rintro h _ ⟨a, ha, rfl⟩
    exact (g.apply_symm_apply (τ (g a))).symm.trans (congrArg (⇑g) (h a ha))
  · intro h a ha
    have hga : τ (g a) = g a := h (g a) ⟨a, ha, rfl⟩
    change g.symm (τ (g a)) = a
    rw [hga]
    exact g.symm_apply_apply a

/-- A subgroup `H : Subgroup (Equiv.Perm ℕ)` is **open** in the pointwise-convergence (nominal)
topology if it contains `pointwiseStabilizer F` for some finite set of atoms `F : Finset ℕ`. -/
def IsOpenSubgroup (H : Subgroup (Equiv.Perm ℕ)) : Prop :=
  ∃ F : Finset ℕ, pointwiseStabilizer F ≤ H

/-- Every basic finite-support stabilizer `pointwiseStabilizer F` is open. -/
theorem isOpenSubgroup_stabilizer (F : Finset ℕ) : IsOpenSubgroup (pointwiseStabilizer F) :=
  ⟨F, le_rfl⟩

/-- The full group `⊤ : Subgroup (Equiv.Perm ℕ)` is open (supported on `∅`). -/
theorem isOpenSubgroup_top : IsOpenSubgroup ⊤ :=
  ⟨∅, le_top⟩

/-- Open subgroups of `Equiv.Perm ℕ` are upward-closed in the subgroup lattice. -/
theorem IsOpenSubgroup.mono {H K : Subgroup (Equiv.Perm ℕ)}
    (hH : IsOpenSubgroup H) (hle : H ≤ K) : IsOpenSubgroup K := by
  rcases hH with ⟨F, hF⟩
  exact ⟨F, hF.trans hle⟩

/-- Binary intersection of open subgroups of `Equiv.Perm ℕ` is open. -/
theorem IsOpenSubgroup.inf {H₁ H₂ : Subgroup (Equiv.Perm ℕ)}
    (h₁ : IsOpenSubgroup H₁) (h₂ : IsOpenSubgroup H₂) : IsOpenSubgroup (H₁ ⊓ H₂) := by
  rcases h₁ with ⟨F₁, hF₁⟩
  rcases h₂ with ⟨F₂, hF₂⟩
  refine ⟨F₁ ∪ F₂, ?_⟩
  rw [pointwiseStabilizer_union]
  exact inf_le_inf hF₁ hF₂

/-- Any conjugate of an open subgroup of `Equiv.Perm ℕ` is open. -/
theorem IsOpenSubgroup.conj {H : Subgroup (Equiv.Perm ℕ)}
    (hH : IsOpenSubgroup H) (g : Equiv.Perm ℕ) : IsOpenSubgroup (MulAut.conj g • H) := by
  rcases hH with ⟨F, hF⟩
  refine ⟨F.image ⇑g, ?_⟩
  rw [← conj_pointwiseStabilizer]
  exact Subgroup.pointwise_smul_le_pointwise_smul_iff.mpr hF

/-- For any non-empty finite support `F`, `pointwiseStabilizer F` is a **strictly proper** open
subgroup of `Equiv.Perm ℕ` (`pointwiseStabilizer F < ⊤`). -/
theorem pointwiseStabilizer_lt_top_of_nonempty {F : Finset ℕ} (hF : F.Nonempty) :
    pointwiseStabilizer F < ⊤ := by
  rw [lt_top_iff_ne_top]
  rcases hF with ⟨a, ha⟩
  intro hTop
  have hmem : Equiv.swap a (a + 1) ∈ pointwiseStabilizer F := by
    rw [hTop]
    trivial
  have hfix : (Equiv.swap a (a + 1)) a = a := hmem a ha
  rw [Equiv.swap_apply_left] at hfix
  omega

/-- **Guardrail 5 (General Permutation-Topos Obstruction):** For any group `G` and any proper
subgroup `U < ⊤`, the inhabited homogeneous coset space `G ⧸ U` admits **no `G`-fixed global
section** (`(G ⧸ U)^G = ∅`). Consequently, whenever `G` possesses a proper open subgroup `U < ⊤`,
the epimorphism `G/U ↠ 1` in `Cont(G)` has empty global sections and `1` is **not** externally
projective. -/
theorem isEmpty_globalSections_quotient_of_lt_top {G : Type*} [Group G] {U : Subgroup G}
    (hU : U < ⊤) : IsEmpty {x : G ⧸ U // ∀ g : G, g • x = x} := by
  refine ⟨fun ⟨x, hx⟩ ↦ lt_irrefl (⊤ : Subgroup G) ?_⟩
  have hTop : U = ⊤ := by
    rw [Subgroup.eq_top_iff']
    obtain ⟨g₀, rfl⟩ := Quotient.exists_rep x
    intro h
    have hfix : (g₀ * h * g₀⁻¹) • (QuotientGroup.mk g₀ : G ⧸ U) = QuotientGroup.mk g₀ :=
      hx (g₀ * h * g₀⁻¹)
    change QuotientGroup.mk (g₀ * h * g₀⁻¹ * g₀) = QuotientGroup.mk g₀ at hfix
    rw [inv_mul_cancel_right] at hfix
    have hmem : g₀⁻¹ * (g₀ * h) ∈ U := QuotientGroup.eq.mp hfix.symm
    simpa [← mul_assoc] using hmem
  exact hTop ▸ hU

/-- Exact characterization of global sections of `G ⧸ U`: `(G ⧸ U)^G` is nonempty if and only if
`U = ⊤`. -/
theorem nonempty_globalSections_quotient_iff_eq_top {G : Type*} [Group G] (U : Subgroup G) :
    Nonempty {x : G ⧸ U // ∀ g : G, g • x = x} ↔ U = ⊤ := by
  constructor
  · intro hne
    by_contra hneTop
    have hlt : U < ⊤ := lt_top_iff_ne_top.mpr hneTop
    exact (isEmpty_globalSections_quotient_of_lt_top hlt).false hne.some
  · rintro rfl
    refine ⟨⟨QuotientGroup.mk 1, fun g ↦ ?_⟩⟩
    exact QuotientGroup.eq.mpr trivial

/-- **Guardrail 5 Witness in `Cont(Sym(ℕ))`:** For every non-empty finite support `F : Finset ℕ`,
the homogeneous coset object `Equiv.Perm ℕ ⧸ pointwiseStabilizer F` has **empty global sections**,
witnessing that the terminal object `1` of Schanuel's Boolean two-valued atomic topos is **not**
externally projective. -/
theorem isEmpty_globalSections_quotient_pointwiseStabilizer {F : Finset ℕ} (hF : F.Nonempty) :
    IsEmpty {x : Equiv.Perm ℕ ⧸ pointwiseStabilizer F // ∀ g : Equiv.Perm ℕ, g • x = x} :=
  isEmpty_globalSections_quotient_of_lt_top (pointwiseStabilizer_lt_top_of_nonempty hF)

/-- Continuity of the homogeneous coset action in `Cont(Sym(ℕ))`: when `IsOpenSubgroup U`, every
coset `x : Equiv.Perm ℕ ⧸ U` is fixed by `pointwiseStabilizer F` for some finite support `F`. -/
theorem exists_open_stabilizer_quotient {U : Subgroup (Equiv.Perm ℕ)} (hU : IsOpenSubgroup U)
    (x : Equiv.Perm ℕ ⧸ U) :
    ∃ F : Finset ℕ, ∀ g ∈ pointwiseStabilizer F, g • x = x := by
  obtain ⟨g₀, rfl⟩ := Quotient.exists_rep x
  rcases hU.conj g₀ with ⟨F, hF⟩
  refine ⟨F, fun g hg ↦ ?_⟩
  have hg' : g ∈ MulAut.conj g₀ • U := hF hg
  rw [Subgroup.mem_pointwise_smul_iff_inv_smul_mem, ← map_inv, MulAut.smul_def,
    MulAut.conj_apply] at hg'
  change QuotientGroup.mk (g * g₀) = QuotientGroup.mk g₀
  rw [QuotientGroup.eq]
  have hinv : (g₀⁻¹ * g * g₀⁻¹⁻¹)⁻¹ ∈ U := U.inv_mem hg'
  simpa [mul_inv_rev, mul_assoc] using hinv

/-! ## Section 2: Open Normal Subgroup Triviality and Pro-Discrete Blindness -/

/-- Auxiliary involutive block-swap function exchanging `[0, B)` with `[B, 2 * B)`. -/
private def blockSwapFun (B n : ℕ) : ℕ :=
  if n < B then n + B else if n < 2 * B then n - B else n

private theorem blockSwapFun_involutive (B : ℕ) : Function.Involutive (blockSwapFun B) := by
  intro n
  unfold blockSwapFun
  split_ifs <;> omega

/-- Block-swap permutation `τ : Equiv.Perm ℕ` exchanging `[0, B)` with `[B, 2 * B)` via `n ↦ n + B`
and fixing `[2 * B, ∞)`. -/
def blockSwapPerm (B : ℕ) : Equiv.Perm ℕ where
  toFun := blockSwapFun B
  invFun := blockSwapFun B
  left_inv := blockSwapFun_involutive B
  right_inv := blockSwapFun_involutive B

theorem blockSwapPerm_apply_of_lt {B n : ℕ} (hn : n < B) :
    blockSwapPerm B n = n + B := by
  change blockSwapFun B n = n + B
  unfold blockSwapFun
  rw [if_pos hn]

/-- Auxiliary decomposition `{x : ℕ // x ∈ A} ≃ {x : ℕ // x ∈ B} ⊕ {x : ℕ // x ∈ A \ B}` for
`B ⊆ A`. -/
private def subtypeSplitEquiv {A B : Finset ℕ} (hBA : B ⊆ A) :
    {x : ℕ // x ∈ A} ≃ {x : ℕ // x ∈ B} ⊕ {x : ℕ // x ∈ A \ B} where
  toFun x :=
    if h : x.1 ∈ B then Sum.inl ⟨x.1, h⟩
    else Sum.inr ⟨x.1, Finset.mem_sdiff.mpr ⟨x.2, h⟩⟩
  invFun
    | Sum.inl y => ⟨y.1, hBA y.2⟩
    | Sum.inr z => ⟨z.1, (Finset.mem_sdiff.mp z.2).1⟩
  left_inv x := by
    dsimp only
    split_ifs <;> rfl
  right_inv s := by
    cases s with
    | inl y => simp [y.2]
    | inr z =>
      have hz : z.1 ∉ B := (Finset.mem_sdiff.mp z.2).2
      simp [hz]

private theorem subtypeSplitEquiv_apply_of_mem {A B : Finset ℕ} (hBA : B ⊆ A)
    (x : {x : ℕ // x ∈ A}) (hx : x.1 ∈ B) :
    subtypeSplitEquiv hBA x = Sum.inl ⟨x.1, hx⟩ := by
  unfold subtypeSplitEquiv
  dsimp only [Equiv.coe_fn_mk]
  exact dif_pos hx

/-- **Theorem 1 (Topological Normal Simplicity of `Sym(ℕ)` / `open_normal_eq_top`):**
Every open normal subgroup `N` of `Equiv.Perm ℕ` equals `⊤`. -/
theorem open_normal_eq_top (N : Subgroup (Equiv.Perm ℕ)) [hN : N.Normal]
    (hOpen : IsOpenSubgroup N) : N = ⊤ := by
  rcases hOpen with ⟨F, hFN⟩
  rw [Subgroup.eq_top_iff']
  intro σ
  let B : ℕ := (F ∪ F.image ⇑σ⁻¹).sup id + 1
  have hltB_of_memF : ∀ x ∈ F, x < B := by
    intro x hx
    have hle : id x ≤ (F ∪ F.image ⇑σ⁻¹).sup id :=
      Finset.le_sup (f := id) (Finset.mem_union_left _ hx)
    dsimp only [id] at hle
    omega
  have hnotMemF_of_geB : ∀ z : ℕ, B ≤ z → z ∉ F ∧ σ z ∉ F := by
    intro z hz
    refine ⟨fun hzF ↦ ?_, fun hσzF ↦ ?_⟩
    · have hlt := hltB_of_memF z hzF
      omega
    · have hmem : σ⁻¹ (σ z) ∈ F ∪ F.image ⇑σ⁻¹ :=
        Finset.mem_union_right _ (Finset.mem_image_of_mem _ hσzF)
      have hle : id (σ⁻¹ (σ z)) ≤ (F ∪ F.image ⇑σ⁻¹).sup id := Finset.le_sup (f := id) hmem
      have hinv : σ⁻¹ (σ z) = z := σ.symm_apply_apply z
      rw [hinv, id_eq] at hle
      omega
  let τ : Equiv.Perm ℕ := blockSwapPerm B
  let K : Finset ℕ := F.image ⇑τ
  let L : Finset ℕ := K.image ⇑σ
  have hK_geB : ∀ k ∈ K, B ≤ k := by
    intro k hk
    rcases Finset.mem_image.mp hk with ⟨x, hxF, rfl⟩
    have hxB : x < B := hltB_of_memF x hxF
    have hτx : τ x = x + B := blockSwapPerm_apply_of_lt hxB
    omega
  let U : Finset ℕ := K ∪ L
  have hU_notMemF : ∀ u ∈ U, u ∉ F := by
    intro u hu
    rcases Finset.mem_union.mp hu with huK | huL
    · exact (hnotMemF_of_geB u (hK_geB u huK)).1
    · rcases Finset.mem_image.mp huL with ⟨k, hkK, rfl⟩
      exact (hnotMemF_of_geB k (hK_geB k hkK)).2
  have hCardKL : K.card = L.card := (Finset.card_image_of_injective K σ.injective).symm
  have hCardSdiff : Fintype.card {x : ℕ // x ∈ U \ K} = Fintype.card {x : ℕ // x ∈ U \ L} := by
    simp only [Fintype.card_coe]
    have h₁ : (U \ K).card + K.card = U.card :=
      Finset.card_sdiff_add_card_eq_card Finset.subset_union_left
    have h₂ : (U \ L).card + L.card = U.card :=
      Finset.card_sdiff_add_card_eq_card Finset.subset_union_right
    omega
  let eKL : {x : ℕ // x ∈ K} ≃ {x : ℕ // x ∈ L} :=
    { toFun := fun x ↦ ⟨σ x.1, Finset.mem_image_of_mem _ x.2⟩
      invFun := fun y ↦ ⟨σ⁻¹ y.1, by
        rcases Finset.mem_image.mp y.2 with ⟨k, hk, hσk⟩
        simpa [← hσk] using hk⟩
      left_inv := fun x ↦ Subtype.ext (σ.symm_apply_apply x.1)
      right_inv := fun y ↦ Subtype.ext (σ.apply_symm_apply y.1) }
  let eCompl : {x : ℕ // x ∈ U \ K} ≃ {x : ℕ // x ∈ U \ L} :=
    Fintype.equivOfCardEq hCardSdiff
  let αU : Equiv.Perm {x : ℕ // x ∈ U} :=
    (subtypeSplitEquiv Finset.subset_union_left).trans
      ((Equiv.sumCongr eKL eCompl).trans (subtypeSplitEquiv Finset.subset_union_right).symm)
  let α : Equiv.Perm ℕ := Equiv.Perm.ofSubtype αU
  have hαF : α ∈ pointwiseStabilizer F := by
    intro a haF
    have haU : a ∉ U := fun haU ↦ hU_notMemF a haU haF
    exact Equiv.Perm.ofSubtype_apply_of_not_mem αU haU
  have hα_on_K : ∀ k ∈ K, α k = σ k := by
    intro k hk
    have hkU : k ∈ U := Finset.mem_union_left L hk
    rw [Equiv.Perm.ofSubtype_apply_of_mem αU hkU]
    dsimp only [αU, Equiv.trans_apply]
    rw [subtypeSplitEquiv_apply_of_mem Finset.subset_union_left ⟨k, hkU⟩ hk]
    rfl
  let β : Equiv.Perm ℕ := τ⁻¹ * (α⁻¹ * σ) * τ
  have hβF : β ∈ pointwiseStabilizer F := by
    intro x hxF
    change τ⁻¹ (α⁻¹ (σ (τ x))) = x
    have hτxK : τ x ∈ K := Finset.mem_image_of_mem _ hxF
    rw [← hα_on_K (τ x) hτxK]
    exact (congrArg (⇑τ⁻¹) (α.symm_apply_apply (τ x))).trans (τ.symm_apply_apply x)
  have hαN : α ∈ N := hFN hαF
  have hβN : β ∈ N := hFN hβF
  have hConjN : τ * β * τ⁻¹ ∈ N := hN.conj_mem β hβN τ
  have hConjEq : τ * β * τ⁻¹ = α⁻¹ * σ := by
    simp [β, mul_assoc]
  rw [hConjEq] at hConjN
  have hProd : α * (α⁻¹ * σ) ∈ N := N.mul_mem hαN hConjN
  simpa [← mul_assoc] using hProd

/-- Any permutation `g ∈ pointwiseStabilizer F` restricts to the complement `{n : ℕ // n ∉ F}`. -/
private theorem not_mem_iff_of_mem_stabilizer {F : Finset ℕ} {g : Equiv.Perm ℕ}
    (hg : g ∈ pointwiseStabilizer F) (n : ℕ) : g n ∉ F ↔ n ∉ F := by
  constructor
  · intro hgn hn
    have heq : g n = n := hg n hn
    rw [← heq] at hn
    exact hgn hn
  · intro hn hgn
    have hfix : g (g n) = g n := hg (g n) hgn
    have hgn_eq : g n = n := g.injective hfix
    rw [hgn_eq] at hgn
    exact hn hgn

/-- Group isomorphism identifying `pointwiseStabilizer F` with all permutations of the complement
subtype `{n : ℕ // n ∉ F}`. -/
def stabilizerMulEquivPermCompl (F : Finset ℕ) :
    pointwiseStabilizer F ≃* Equiv.Perm {n : ℕ // n ∉ F} where
  toFun g := g.1.subtypePerm (not_mem_iff_of_mem_stabilizer g.2)
  invFun π := ⟨Equiv.Perm.ofSubtype π, fun a ha ↦
    Equiv.Perm.ofSubtype_apply_of_not_mem (p := fun n : ℕ ↦ n ∉ F) π (not_not.mpr ha)⟩
  left_inv g := by
    ext x
    by_cases hx : x ∉ F
    · simp [Equiv.Perm.ofSubtype_apply_of_mem (p := fun n : ℕ ↦ n ∉ F) _ hx]
    · push_neg at hx
      rw [Equiv.Perm.ofSubtype_apply_of_not_mem (p := fun n : ℕ ↦ n ∉ F) _ (not_not.mpr hx)]
      exact (g.2 x hx).symm
  right_inv π := by
    ext x
    simp
  map_mul' g₁ g₂ := by
    ext x
    rfl

/-- The complement `{n : ℕ // n ∉ F}` of any finite support `F : Finset ℕ` is `Infinite`. -/
instance instInfiniteComplFinsetNat (F : Finset ℕ) : Infinite {n : ℕ // n ∉ F} := by
  let M : ℕ := F.sup id + 1
  refine Infinite.of_injective (fun k : ℕ ↦ ⟨k + M, ?_⟩) (fun a b h ↦ ?_)
  · intro hmem
    have hle : id (k + M) ≤ F.sup id := Finset.le_sup (f := id) hmem
    dsimp only [id] at hle
    omega
  · have hval : a + M = b + M := congrArg Subtype.val h
    omega

/-- Explicit `Denumerable` structure on `{n : ℕ // n ∉ F}` via `Nat.Subtype.denumerable`. -/
def denumerableComplFinsetNat (F : Finset ℕ) : Denumerable {n : ℕ // n ∉ F} :=
  letI : DecidablePred (· ∈ ({n : ℕ | n ∉ F} : Set ℕ)) :=
    fun n ↦ inferInstanceAs (Decidable (n ∉ F))
  letI : Infinite ({n : ℕ | n ∉ F} : Set ℕ) := instInfiniteComplFinsetNat F
  Nat.Subtype.denumerable {n : ℕ | n ∉ F}

/-- Explicit bijection `{n : ℕ // n ∉ F} ≃ ℕ` for any finite support `F : Finset ℕ`. -/
def complFinsetNatEquivNat (F : Finset ℕ) : {n : ℕ // n ∉ F} ≃ ℕ :=
  @Denumerable.eqv {n : ℕ // n ∉ F} (denumerableComplFinsetNat F)

/-- Topological-group self-similarity `pointwiseStabilizer F ≃* Equiv.Perm ℕ` induced by
`{n : ℕ // n ∉ F} ≃ ℕ`. -/
def stabilizerMulEquivPermNat (F : Finset ℕ) :
    pointwiseStabilizer F ≃* Equiv.Perm ℕ :=
  (stabilizerMulEquivPermCompl F).trans (Equiv.permCongrHom (complFinsetNatEquivNat F))

/-- Transporting the trace of any open subgroup `H` on `pointwiseStabilizer F` along
`stabilizerMulEquivPermNat F` produces an open subgroup of `Equiv.Perm ℕ`. -/
theorem isOpenSubgroup_map_stabilizerMulEquivPermNat {F : Finset ℕ}
    {H : Subgroup (Equiv.Perm ℕ)} (hOpen : IsOpenSubgroup H) :
    IsOpenSubgroup
      ((H.subgroupOf (pointwiseStabilizer F)).map (stabilizerMulEquivPermNat F).toMonoidHom) := by
  rcases hOpen with ⟨F₁, hF₁⟩
  let φ : {n : ℕ // n ∉ F} ≃ ℕ := complFinsetNatEquivNat F
  let F₂ : Finset ℕ :=
    (F₁ \ F).attach.image (fun x ↦ φ ⟨x.1, (Finset.mem_sdiff.mp x.2).2⟩)
  refine ⟨F₂, fun σ hσ ↦ ?_⟩
  rw [Subgroup.mem_map]
  refine ⟨(stabilizerMulEquivPermNat F).symm σ, ?_,
    (stabilizerMulEquivPermNat F).apply_symm_apply σ⟩
  rw [Subgroup.mem_subgroupOf]
  apply hF₁
  intro a ha₁
  by_cases haF : a ∈ F
  · exact ((stabilizerMulEquivPermNat F).symm σ).2 a haF
  · have haSdiff : a ∈ F₁ \ F := Finset.mem_sdiff.mpr ⟨ha₁, haF⟩
    let u : {n : ℕ // n ∉ F} := ⟨a, haF⟩
    have hφu : φ u ∈ F₂ := by
      rw [Finset.mem_image]
      exact ⟨⟨a, haSdiff⟩, Finset.mem_attach _ _, rfl⟩
    have hfixσ : σ (φ u) = φ u := hσ (φ u) hφu
    change Equiv.Perm.ofSubtype (p := fun n : ℕ ↦ n ∉ F) (φ.symm.permCongr σ) a = a
    rw [Equiv.Perm.ofSubtype_apply_of_mem (p := fun n : ℕ ↦ n ∉ F) _ haF]
    change (φ.symm (σ (φ u)) : ℕ) = a
    rw [hfixσ, φ.symm_apply_apply]

/-- For any finite-index open subgroup `H` of `Equiv.Perm ℕ`, its normal core `H.normalCore` is a
finite intersection of conjugates of `H` and is therefore also open (`IsOpenSubgroup`). -/
theorem isOpenSubgroup_normalCore {H : Subgroup (Equiv.Perm ℕ)}
    (hOpen : IsOpenSubgroup H) [H.FiniteIndex] :
    IsOpenSubgroup H.normalCore := by
  rcases hOpen with ⟨F₁, hF₁⟩
  letI : Fintype (Equiv.Perm ℕ ⧸ H) := Subgroup.fintypeQuotientOfFiniteIndex
  let FCore : Finset ℕ :=
    (Finset.univ : Finset (Equiv.Perm ℕ ⧸ H)).biUnion
      (fun c ↦ F₁.image ⇑(Quotient.out c))
  refine ⟨FCore, fun a ha b ↦ ?_⟩
  let c : Equiv.Perm ℕ ⧸ H := QuotientGroup.mk b⁻¹
  let r : Equiv.Perm ℕ := Quotient.out c
  have hrc : (QuotientGroup.mk r : Equiv.Perm ℕ ⧸ H) = QuotientGroup.mk b⁻¹ :=
    Quotient.out_eq c
  have hrb_inv : r⁻¹ * b⁻¹ ∈ H := QuotientGroup.eq.mp hrc
  have hbr : b * r ∈ H := by
    simpa [mul_inv_rev] using H.inv_mem hrb_inv
  have hrar : r⁻¹ * a * r ∈ H := by
    apply hF₁
    intro x hx
    have hrx : r x ∈ FCore := by
      rw [Finset.mem_biUnion]
      exact ⟨c, Finset.mem_univ c, Finset.mem_image_of_mem _ hx⟩
    have hax : a (r x) = r x := ha (r x) hrx
    change r⁻¹ (a (r x)) = x
    rw [hax]
    exact r.symm_apply_apply x
  have hprod : (b * r) * (r⁻¹ * a * r) * (b * r)⁻¹ ∈ H :=
    H.mul_mem (H.mul_mem hbr hrar) (H.inv_mem hbr)
  have heq : (b * r) * (r⁻¹ * a * r) * (b * r)⁻¹ = b * a * b⁻¹ := by
    simp [mul_assoc]
  rwa [heq] at hprod

/-- **Pro-Discrete Blindness on `Sym(ℕ)` (`open_finiteIndex_eq_top`):**
`Equiv.Perm ℕ` has **no proper finite-index open subgroups**. -/
theorem open_finiteIndex_eq_top (H : Subgroup (Equiv.Perm ℕ))
    (hOpen : IsOpenSubgroup H) [H.FiniteIndex] : H = ⊤ := by
  have hCoreOpen : IsOpenSubgroup H.normalCore := isOpenSubgroup_normalCore hOpen
  have hCoreTop : H.normalCore = ⊤ := open_normal_eq_top H.normalCore hCoreOpen
  exact top_unique (hCoreTop ▸ H.normalCore_le)

/-- **Theorem 2a (Open Normal Blindness Over `pointwiseStabilizer F`):**
For every finite support `F : Finset ℕ` and every open subgroup `H` of `Equiv.Perm ℕ`, if
`H.subgroupOf (pointwiseStabilizer F)` is normal in `pointwiseStabilizer F`, then
`H.subgroupOf (pointwiseStabilizer F) = ⊤`. -/
theorem open_normal_subgroupOf_stabilizer_eq_top {F : Finset ℕ}
    (H : Subgroup (Equiv.Perm ℕ)) (hOpen : IsOpenSubgroup H)
    [hNorm : (H.subgroupOf (pointwiseStabilizer F)).Normal] :
    H.subgroupOf (pointwiseStabilizer F) = ⊤ := by
  let e := stabilizerMulEquivPermNat F
  let U := H.subgroupOf (pointwiseStabilizer F)
  haveI : (U.map e.toMonoidHom).Normal :=
    ⟨fun n hn g ↦ by
      rcases Subgroup.mem_map.mp hn with ⟨u, hu, rfl⟩
      refine Subgroup.mem_map.mpr
        ⟨e.symm g * u * (e.symm g)⁻¹, hNorm.conj_mem u hu (e.symm g), ?_⟩
      simp⟩
  have hMapOpen : IsOpenSubgroup (U.map e.toMonoidHom) :=
    isOpenSubgroup_map_stabilizerMulEquivPermNat hOpen
  have hMapTop : U.map e.toMonoidHom = ⊤ := open_normal_eq_top _ hMapOpen
  rw [Subgroup.eq_top_iff']
  intro g
  have hgMap : e g ∈ U.map e.toMonoidHom := by
    rw [hMapTop]
    trivial
  rcases Subgroup.mem_map.mp hgMap with ⟨g', hg'U, hg'eq⟩
  have hgg' : g' = g := e.injective hg'eq
  exact hgg' ▸ hg'U

/-- Explicit subgroup-equality form of Open Normal Blindness inside `pointwiseStabilizer F`. -/
theorem open_normal_in_stabilizer_eq {F : Finset ℕ} {H : Subgroup (Equiv.Perm ℕ)}
    (hLE : H ≤ pointwiseStabilizer F) (hOpen : IsOpenSubgroup H)
    [(H.subgroupOf (pointwiseStabilizer F)).Normal] :
    H = pointwiseStabilizer F := by
  have hSubTop := open_normal_subgroupOf_stabilizer_eq_top (F := F) H hOpen
  refine le_antisymm hLE (fun g hg ↦ ?_)
  have hmem : (⟨g, hg⟩ : pointwiseStabilizer F) ∈ H.subgroupOf (pointwiseStabilizer F) := by
    rw [hSubTop]
    trivial
  exact Subgroup.mem_subgroupOf.mp hmem

/-- **Theorem 2b (Finite-Index Open Subgroup Blindness Over `pointwiseStabilizer F`):**
For every finite support `F : Finset ℕ` and every open subgroup `H` of `Equiv.Perm ℕ` such that
`H.subgroupOf (pointwiseStabilizer F)` has finite index in `pointwiseStabilizer F`, we have
`H.subgroupOf (pointwiseStabilizer F) = ⊤`. -/
theorem open_finiteIndex_subgroupOf_stabilizer_eq_top {F : Finset ℕ}
    (H : Subgroup (Equiv.Perm ℕ)) (hOpen : IsOpenSubgroup H)
    [hFin : (H.subgroupOf (pointwiseStabilizer F)).FiniteIndex] :
    H.subgroupOf (pointwiseStabilizer F) = ⊤ := by
  let e := stabilizerMulEquivPermNat F
  let U := H.subgroupOf (pointwiseStabilizer F)
  have hComap : (U.map e.toMonoidHom).comap e.toMonoidHom = U :=
    Subgroup.comap_map_eq_self_of_injective e.injective U
  haveI : Finite (Equiv.Perm ℕ ⧸ U.map e.toMonoidHom) := by
    refine Finite.of_injective
      (fun c : Equiv.Perm ℕ ⧸ U.map e.toMonoidHom ↦
        (QuotientGroup.mk (e.symm (Quotient.out c)) : pointwiseStabilizer F ⧸ U))
      (fun c₁ c₂ hc ↦ ?_)
    have hmemU : (e.symm (Quotient.out c₁))⁻¹ * e.symm (Quotient.out c₂) ∈ U :=
      QuotientGroup.eq.mp hc
    have hmemMap :
        (Quotient.out c₁)⁻¹ * Quotient.out c₂ ∈ U.map e.toMonoidHom := by
      have hm := Subgroup.mem_map_of_mem e.toMonoidHom hmemU
      simpa using hm
    have hmk :
        (QuotientGroup.mk (Quotient.out c₁) : Equiv.Perm ℕ ⧸ U.map e.toMonoidHom) =
          QuotientGroup.mk (Quotient.out c₂) :=
      QuotientGroup.eq.mpr hmemMap
    simpa only [Quotient.out_eq] using hmk
  haveI : (U.map e.toMonoidHom).FiniteIndex := Subgroup.finiteIndex_of_finite_quotient
  have hMapOpen : IsOpenSubgroup (U.map e.toMonoidHom) :=
    isOpenSubgroup_map_stabilizerMulEquivPermNat hOpen
  have hMapTop : U.map e.toMonoidHom = ⊤ := open_finiteIndex_eq_top _ hMapOpen
  change U = ⊤
  rw [← hComap, hMapTop, Subgroup.comap_top]

/-- Finite-quotient formulation of Pro-Discrete Blindness over `pointwiseStabilizer F`: every open
subgroup `H ≤ pointwiseStabilizer F` with `Finite (pointwiseStabilizer F ⧸ H.subgroupOf _)` equals
`pointwiseStabilizer F`. -/
theorem open_finiteRelIndex_eq_stabilizer {F : Finset ℕ} {H : Subgroup (Equiv.Perm ℕ)}
    (hLE : H ≤ pointwiseStabilizer F) (hOpen : IsOpenSubgroup H)
    (hFin : Finite (pointwiseStabilizer F ⧸ H.subgroupOf (pointwiseStabilizer F))) :
    H = pointwiseStabilizer F := by
  haveI : (H.subgroupOf (pointwiseStabilizer F)).FiniteIndex :=
    @Subgroup.finiteIndex_of_finite_quotient _ _ _ hFin
  have hSubTop := open_finiteIndex_subgroupOf_stabilizer_eq_top (F := F) H hOpen
  refine le_antisymm hLE (fun g hg ↦ ?_)
  have hmem : (⟨g, hg⟩ : pointwiseStabilizer F) ∈ H.subgroupOf (pointwiseStabilizer F) := by
    rw [hSubTop]
    trivial
  exact Subgroup.mem_subgroupOf.mp hmem

/-- Non-zero relative-index formulation of Pro-Discrete Blindness over `pointwiseStabilizer F`:
if `H ≤ pointwiseStabilizer F`, `IsOpenSubgroup H`, and `H.relIndex (pointwiseStabilizer F) ≠ 0`,
then `H = pointwiseStabilizer F`. -/
theorem open_relIndex_ne_zero_eq_stabilizer {F : Finset ℕ} {H : Subgroup (Equiv.Perm ℕ)}
    (hLE : H ≤ pointwiseStabilizer F) (hOpen : IsOpenSubgroup H)
    (hRel : H.relIndex (pointwiseStabilizer F) ≠ 0) :
    H = pointwiseStabilizer F := by
  haveI : (H.subgroupOf (pointwiseStabilizer F)).FiniteIndex :=
    Subgroup.finiteIndex_iff.mpr hRel
  have hSubTop := open_finiteIndex_subgroupOf_stabilizer_eq_top (F := F) H hOpen
  refine le_antisymm hLE (fun g hg ↦ ?_)
  have hmem : (⟨g, hg⟩ : pointwiseStabilizer F) ∈ H.subgroupOf (pointwiseStabilizer F) := by
    rw [hSubTop]
    trivial
  exact Subgroup.mem_subgroupOf.mp hmem

/-! ## Section 3: The `ZMod 2` Even-`Finset` Sheaf `EvenFinset` and Parity Torsor `T_odd` -/

/-- Exact cardinality conservation law for symmetric difference on `Finset ℕ`:
`(S ∆ T).card + 2 * (S ∩ T).card = S.card + T.card`. -/
theorem card_symmDiff_add_two_mul_inter (S T : Finset ℕ) :
    (S ∆ T).card + 2 * (S ∩ T).card = S.card + T.card := by
  have hUnion : S ∆ T = (S \ T) ∪ (T \ S) := rfl
  have hCardΔ : (S ∆ T).card = (S \ T).card + (T \ S).card := by
    rw [hUnion]
    exact Finset.card_union_of_disjoint disjoint_sdiff_sdiff
  have h₁ := Finset.card_sdiff_add_card_inter S T
  have h₂ := Finset.card_sdiff_add_card_inter T S
  rw [Finset.inter_comm T S] at h₂
  omega

/-- Modulo `2`, symmetric difference adds cardinalities in `ZMod 2`:
`((S ∆ T).card : ZMod 2) = (S.card : ZMod 2) + (T.card : ZMod 2)`. -/
theorem natCast_card_symmDiff_zmod2 (S T : Finset ℕ) :
    ((S ∆ T).card : ZMod 2) = (S.card : ZMod 2) + (T.card : ZMod 2) := by
  have h := congrArg (Nat.cast (R := ZMod 2)) (card_symmDiff_add_two_mul_inter S T)
  have h2 : (2 : ZMod 2) = 0 := by decide
  push_cast at h
  rw [h2, zero_mul, add_zero] at h
  exact h

/-- `Even S.card` holds if and only if `(S.card : ZMod 2) = 0`. -/
theorem even_card_iff_zmod2_eq_zero (S : Finset ℕ) :
    Even S.card ↔ (S.card : ZMod 2) = 0 := by
  have h2 : (2 : ZMod 2) = 0 := by decide
  have h1 : (1 : ZMod 2) ≠ 0 := by decide
  rcases Nat.even_or_odd S.card with ⟨k, hk⟩ | ⟨k, hk⟩
  · refine ⟨fun _ ↦ ?_, fun _ ↦ ⟨k, hk⟩⟩
    rw [hk, Nat.cast_add, ← two_mul, h2, zero_mul]
  · refine ⟨fun hEven ↦ ?_, fun hz ↦ ?_⟩
    · rcases hEven with ⟨m, hm⟩
      omega
    · rw [hk, Nat.cast_add, Nat.cast_mul, Nat.cast_ofNat, h2, zero_mul, zero_add,
        Nat.cast_one] at hz
      exact absurd hz h1

/-- `Odd S.card` holds if and only if `(S.card : ZMod 2) = 1`. -/
theorem odd_card_iff_zmod2_eq_one (S : Finset ℕ) :
    Odd S.card ↔ (S.card : ZMod 2) = 1 := by
  have h2 : (2 : ZMod 2) = 0 := by decide
  have h01 : (0 : ZMod 2) ≠ 1 := by decide
  rcases Nat.even_or_odd S.card with ⟨k, hk⟩ | ⟨k, hk⟩
  · refine ⟨fun hOdd ↦ ?_, fun hz ↦ ?_⟩
    · rcases hOdd with ⟨m, hm⟩
      omega
    · rw [hk, Nat.cast_add, ← two_mul, h2, zero_mul] at hz
      exact absurd hz h01
  · refine ⟨fun _ ↦ ?_, fun _ ↦ ⟨k, hk⟩⟩
    rw [hk, Nat.cast_add, Nat.cast_mul, Nat.cast_ofNat, h2, zero_mul, zero_add, Nat.cast_one]

/-- Symmetric difference of two even-cardinality finite sets has even cardinality. -/
theorem even_card_symmDiff_of_even {S T : Finset ℕ}
    (hS : Even S.card) (hT : Even T.card) : Even (S ∆ T).card := by
  rw [even_card_iff_zmod2_eq_zero] at hS hT ⊢
  rw [natCast_card_symmDiff_zmod2, hS, hT, add_zero]

/-- Symmetric difference of an even-cardinality finite set and an odd-cardinality finite set has
odd cardinality. -/
theorem odd_card_symmDiff_of_even_odd {E T : Finset ℕ}
    (hE : Even E.card) (hT : Odd T.card) : Odd (E ∆ T).card := by
  rw [even_card_iff_zmod2_eq_zero] at hE
  rw [odd_card_iff_zmod2_eq_one] at hT ⊢
  rw [natCast_card_symmDiff_zmod2, hE, hT, zero_add]

/-- Symmetric difference of two odd-cardinality finite sets has even cardinality. -/
theorem even_card_symmDiff_of_odd_odd {T₁ T₂ : Finset ℕ}
    (h₁ : Odd T₁.card) (h₂ : Odd T₂.card) : Even (T₁ ∆ T₂).card := by
  rw [odd_card_iff_zmod2_eq_one] at h₁ h₂
  rw [even_card_iff_zmod2_eq_zero, natCast_card_symmDiff_zmod2, h₁, h₂]
  decide

/-- The internal sheaf `A₀ = 𝔽₂[ℕ]₀` of **even-cardinality finite subsets** of `ℕ` in
`Cont(Sym(ℕ))`. -/
abbrev EvenFinset : Type := {S : Finset ℕ // Even S.card}

instance : Zero EvenFinset := ⟨⟨∅, ⟨0, rfl⟩⟩⟩

instance : Add EvenFinset := ⟨fun E₁ E₂ ↦ ⟨E₁.1 ∆ E₂.1, even_card_symmDiff_of_even E₁.2 E₂.2⟩⟩

instance : Neg EvenFinset := ⟨fun E ↦ E⟩

instance : Sub EvenFinset := ⟨fun E₁ E₂ ↦ ⟨E₁.1 ∆ E₂.1, even_card_symmDiff_of_even E₁.2 E₂.2⟩⟩

/-- `EvenFinset` is an `AddCommGroup` under symmetric difference `∆` with `0 = ∅` and `-E = E`. -/
instance instAddCommGroupEvenFinset : AddCommGroup EvenFinset where
  nsmul := nsmulRec
  zsmul := zsmulRec
  add_assoc E₁ E₂ E₃ := Subtype.ext (symmDiff_assoc E₁.1 E₂.1 E₃.1)
  zero_add E := Subtype.ext (bot_symmDiff E.1)
  add_zero E := Subtype.ext (symmDiff_bot E.1)
  neg_add_cancel E := Subtype.ext (symmDiff_self E.1)
  sub_eq_add_neg _ _ := rfl
  add_comm E₁ E₂ := Subtype.ext (symmDiff_comm E₁.1 E₂.1)

@[simp]
theorem evenFinset_zero_val : (0 : EvenFinset).1 = ∅ := rfl

@[simp]
theorem evenFinset_add_val (E₁ E₂ : EvenFinset) : (E₁ + E₂).1 = E₁.1 ∆ E₂.1 := rfl

@[simp]
theorem evenFinset_neg_eq (E : EvenFinset) : -E = E := rfl

/-- Every element of `EvenFinset` has exponent `2` (`E + E = 0`, hence `2 • E = 0`). -/
theorem evenFinset_add_self (E : EvenFinset) : E + E = 0 :=
  Subtype.ext (symmDiff_self E.1)

/-- Scalar `2 • E = 0` in `EvenFinset`. -/
theorem two_nsmul_evenFinset (E : EvenFinset) : (2 : ℕ) • E = 0 := by
  rw [two_nsmul, evenFinset_add_self]

private theorem zmod2_eq_zero_or_one (c : ZMod 2) : c = 0 ∨ c = 1 := by
  have hlt : c.val < 2 := ZMod.val_lt c
  have hcast : (c.val : ZMod 2) = c := ZMod.natCast_zmod_val c
  match h : c.val with
  | 0 =>
    left
    simpa [h] using hcast.symm
  | 1 =>
    right
    simpa [h] using hcast.symm
  | n + 2 => omega

/-- `ZMod 2`-vector space (`Module (ZMod 2) EvenFinset`) structure on `EvenFinset`. -/
instance instModuleZMod2EvenFinset : Module (ZMod 2) EvenFinset where
  smul c E := if c = 0 then 0 else E
  one_smul E := by
    change (if (1 : ZMod 2) = 0 then 0 else E) = E
    have h10 : (1 : ZMod 2) ≠ 0 := by decide
    rw [if_neg h10]
  mul_smul r s E := by
    change (if r * s = 0 then 0 else E) =
      if r = 0 then 0 else if s = 0 then 0 else E
    rcases zmod2_eq_zero_or_one r with rfl | rfl <;>
      rcases zmod2_eq_zero_or_one s with rfl | rfl <;> rfl
  smul_zero r := by
    change (if r = 0 then (0 : EvenFinset) else 0) = 0
    split_ifs <;> rfl
  smul_add r E₁ E₂ := by
    change (if r = 0 then 0 else E₁ + E₂) =
      (if r = 0 then 0 else E₁) + (if r = 0 then 0 else E₂)
    rcases zmod2_eq_zero_or_one r with rfl | rfl
    · simp
    · have h10 : (1 : ZMod 2) ≠ 0 := by decide
      simp [h10]
  add_smul r s E := by
    change (if r + s = 0 then 0 else E) =
      (if r = 0 then 0 else E) + (if s = 0 then 0 else E)
    have h10 : (1 : ZMod 2) ≠ 0 := by decide
    have h11 : (1 : ZMod 2) + 1 = 0 := by decide
    rcases zmod2_eq_zero_or_one r with rfl | rfl <;>
      rcases zmod2_eq_zero_or_one s with rfl | rfl
    · simp
    · simp [h10]
    · simp [h10]
    · simp [h10, h11, evenFinset_add_self]
  zero_smul E := if_pos rfl

/-- Continuous `Equiv.Perm ℕ`-action on `EvenFinset` by additive group automorphisms (`σ • E =
⟨E.1.image ⇑σ, _⟩`). -/
instance instDistribMulActionPermEvenFinset : DistribMulAction (Equiv.Perm ℕ) EvenFinset where
  smul σ E := ⟨E.1.image ⇑σ, by
    rw [Finset.card_image_of_injective E.1 σ.injective]
    exact E.2⟩
  one_smul E := Subtype.ext Finset.image_id
  mul_smul σ τ E := Subtype.ext (by
    change E.1.image ⇑(σ * τ) = (E.1.image ⇑τ).image ⇑σ
    rw [Finset.image_image]
    rfl)
  smul_zero σ := Subtype.ext (Finset.image_empty ⇑σ)
  smul_add σ E₁ E₂ := Subtype.ext (Finset.image_symmDiff E₁.1 E₂.1 σ.injective)

@[simp]
theorem evenFinset_smul_val (σ : Equiv.Perm ℕ) (E : EvenFinset) :
    (σ • E).1 = E.1.image ⇑σ := rfl

/-- Compatibility between the `Equiv.Perm ℕ`-action and `ZMod 2`-scalar multiplication on
`EvenFinset`. -/
instance instSMulCommClassPermZMod2EvenFinset :
    SMulCommClass (Equiv.Perm ℕ) (ZMod 2) EvenFinset where
  smul_comm σ c E := by
    change σ • (if c = 0 then 0 else E) = if c = 0 then 0 else σ • E
    split_ifs with hc
    · exact smul_zero σ
    · rfl

/-- Continuity of `EvenFinset` in `Cont(Sym(ℕ))`: every `E : EvenFinset` is fixed by
`pointwiseStabilizer E.1`. -/
theorem evenFinset_fixed_by_stabilizer (E : EvenFinset) :
    ∀ σ ∈ pointwiseStabilizer E.1, σ • E = E := by
  intro σ hσ
  apply Subtype.ext
  ext x
  simp only [evenFinset_smul_val, Finset.mem_image]
  refine ⟨?_, fun hx ↦ ⟨x, hx, hσ x hx⟩⟩
  rintro ⟨a, ha, rfl⟩
  rwa [hσ a ha]

/-- The **odd-parity torsor** `T_odd := {S : Finset ℕ // Odd S.card}` in `Cont(Sym(ℕ))`. -/
abbrev T_odd : Type := {S : Finset ℕ // Odd S.card}

/-- `T_odd` is inhabited (e.g. by `{0}`). -/
instance instNonemptyTOdd : Nonempty T_odd :=
  ⟨⟨{0}, by simp⟩⟩

/-- Additive action of `EvenFinset` on `T_odd` via symmetric difference `E +ᵥ T = ⟨E.1 ∆ T.1, _⟩`.
-/
instance instAddActionEvenFinsetTOdd : AddAction EvenFinset T_odd where
  vadd E T := ⟨E.1 ∆ T.1, odd_card_symmDiff_of_even_odd E.2 T.2⟩
  zero_vadd T := Subtype.ext (bot_symmDiff T.1)
  add_vadd E₁ E₂ T := Subtype.ext (symmDiff_assoc E₁.1 E₂.1 T.1)

/-- Torsor subtraction `T₁ -ᵥ T₂ = ⟨T₁.1 ∆ T₂.1, _⟩ : EvenFinset` on `T_odd`. -/
instance instVSubEvenFinsetTOdd : VSub EvenFinset T_odd where
  vsub T₁ T₂ := ⟨T₁.1 ∆ T₂.1, even_card_symmDiff_of_odd_odd T₁.2 T₂.2⟩

@[simp]
theorem t_odd_vadd_val (E : EvenFinset) (T : T_odd) : (E +ᵥ T).1 = E.1 ∆ T.1 := rfl

@[simp]
theorem t_odd_vsub_val (T₁ T₂ : T_odd) : (T₁ -ᵥ T₂).1 = T₁.1 ∆ T₂.1 := rfl

/-- `T_odd` is a genuine `AddTorsor` over `EvenFinset` under symmetric difference `∆`. -/
instance instAddTorsorEvenFinsetTOdd : AddTorsor EvenFinset T_odd where
  vsub_vadd' T₁ T₂ := Subtype.ext (by
    change (T₁.1 ∆ T₂.1) ∆ T₂.1 = T₁.1
    rw [symmDiff_assoc, symmDiff_self, symmDiff_bot])
  vadd_vsub' E T := Subtype.ext (by
    change (E.1 ∆ T.1) ∆ T.1 = E.1
    rw [symmDiff_assoc, symmDiff_self, symmDiff_bot])

/-- Continuous `Equiv.Perm ℕ`-action on `T_odd` via finset image. -/
instance instMulActionPermTOdd : MulAction (Equiv.Perm ℕ) T_odd where
  smul σ T := ⟨T.1.image ⇑σ, by
    rw [Finset.card_image_of_injective T.1 σ.injective]
    exact T.2⟩
  one_smul T := Subtype.ext Finset.image_id
  mul_smul σ τ T := Subtype.ext (by
    change T.1.image ⇑(σ * τ) = (T.1.image ⇑τ).image ⇑σ
    rw [Finset.image_image]
    rfl)

@[simp]
theorem t_odd_smul_val (σ : Equiv.Perm ℕ) (T : T_odd) : (σ • T).1 = T.1.image ⇑σ := rfl

/-- Continuity of `T_odd` in `Cont(Sym(ℕ))`: every `T : T_odd` is fixed by
`pointwiseStabilizer T.1`. -/
theorem t_odd_fixed_by_stabilizer (T : T_odd) :
    ∀ σ ∈ pointwiseStabilizer T.1, σ • T = T := by
  intro σ hσ
  apply Subtype.ext
  ext x
  simp only [t_odd_smul_val, Finset.mem_image]
  refine ⟨?_, fun hx ↦ ⟨x, hx, hσ x hx⟩⟩
  rintro ⟨a, ha, rfl⟩
  rwa [hσ a ha]

/-- `Equiv.Perm ℕ`-equivariance of the torsor translation `+ᵥ` on `T_odd`. -/
theorem smul_vadd_t_odd (σ : Equiv.Perm ℕ) (E : EvenFinset) (T : T_odd) :
    σ • (E +ᵥ T) = (σ • E) +ᵥ (σ • T) :=
  Subtype.ext (Finset.image_symmDiff E.1 T.1 σ.injective)

/-- `Equiv.Perm ℕ`-equivariance of the torsor difference `-ᵥ` on `T_odd`. -/
theorem smul_vsub_t_odd (σ : Equiv.Perm ℕ) (T₁ T₂ : T_odd) :
    σ • (T₁ -ᵥ T₂) = (σ • T₁) -ᵥ (σ • T₂) :=
  Subtype.ext (Finset.image_symmDiff T₁.1 T₂.1 σ.injective)

/-- **Global Sections of `T_odd` Are Empty (`Γ(T_odd) = ∅`):** No odd-cardinality finite set of
naturals is invariant under all permutations `Equiv.Perm ℕ`. -/
theorem isEmpty_t_odd_globalSections :
    IsEmpty {t : T_odd // ∀ σ : Equiv.Perm ℕ, σ • t = t} := by
  refine ⟨fun ⟨t, ht⟩ ↦ ?_⟩
  have hpos : 0 < t.1.card := t.2.pos
  rcases Finset.card_pos.mp hpos with ⟨a, ha⟩
  let b : ℕ := t.1.sup id + 1
  have hb_not_mem : b ∉ t.1 := by
    intro hb
    have hle : id b ≤ t.1.sup id := Finset.le_sup (f := id) hb
    dsimp only [id] at hle
    omega
  have hfix : Equiv.swap a b • t = t := ht (Equiv.swap a b)
  have hb_mem : b ∈ t.1 := by
    have hval := congrArg Subtype.val hfix
    rw [← hval]
    change b ∈ t.1.image ⇑(Equiv.swap a b)
    rw [Finset.mem_image]
    exact ⟨a, ha, Equiv.swap_apply_left a b⟩
  exact hb_not_mem hb_mem

/-- **Sheaf Witness 1 (Global Sections Over `∅` Are Empty):** Over the empty support `∅ : Finset ℕ`
(corresponding to the terminal object `1 = y(∅)`), `T_odd` has no `pointwiseStabilizer ∅`-fixed
sections, proving `[T_odd] ≠ 0 ∈ H¹_Nom(1, EvenFinset)`. -/
theorem isEmpty_t_odd_sections_empty :
    IsEmpty {t : T_odd // ∀ σ ∈ pointwiseStabilizer (∅ : Finset ℕ), σ • t = t} := by
  refine ⟨fun ⟨t, ht⟩ ↦ isEmpty_t_odd_globalSections.false ⟨t, fun σ ↦ ht σ ?_⟩⟩
  simp

/-- Canonical 1-atom element `{a} ∈ T_odd` trivializing `T_odd` over the support `{a}`. -/
def atomSection (a : ℕ) : T_odd :=
  ⟨{a}, by simp⟩

@[simp]
theorem atomSection_val (a : ℕ) : (atomSection a).1 = {a} := rfl

/-- `atomSection a` is fixed by every permutation in `pointwiseStabilizer {a}`. -/
theorem atomSection_fixed (a : ℕ) :
    ∀ σ ∈ pointwiseStabilizer ({a} : Finset ℕ), σ • atomSection a = atomSection a :=
  t_odd_fixed_by_stabilizer (atomSection a)

/-- Bundled local section of `T_odd` over the 1-atom support `{a}`. -/
def atomLocalSection (a : ℕ) :
    {t : T_odd // ∀ σ ∈ pointwiseStabilizer ({a} : Finset ℕ), σ • t = t} :=
  ⟨atomSection a, atomSection_fixed a⟩

/-- **Sheaf Witness 2 (Fresh-Atom Local Trivialization Over `{a}`):** Over any 1-atom support
`{a}`, `T_odd` admits a canonical `pointwiseStabilizer {a}`-fixed section `atomLocalSection a`. -/
theorem nonempty_t_odd_sections_singleton (a : ℕ) :
    Nonempty {t : T_odd // ∀ σ ∈ pointwiseStabilizer ({a} : Finset ℕ), σ • t = t} :=
  ⟨atomLocalSection a⟩

/-- **Sheaf Witness 3a (Čech Coboundary Formula):** The torsor difference between local
trivializations `atomSection a` and `atomSection b` has underlying finset `{a} ∆ {b}`. -/
theorem atomSection_vsub_val (a b : ℕ) :
    (atomSection a -ᵥ atomSection b).1 = ({a} : Finset ℕ) ∆ {b} :=
  rfl

/-- For distinct atoms `a ≠ b`, `{a} ∆ {b} = {a, b}`. -/
theorem singleton_symmDiff_singleton_of_ne {a b : ℕ} (hab : a ≠ b) :
    ({a} : Finset ℕ) ∆ {b} = {a, b} := by
  have hDisj : Disjoint ({a} : Finset ℕ) {b} := Finset.disjoint_singleton.mpr hab
  rw [Finset.symmDiff_eq_union hDisj]
  rfl

/-- **Sheaf Witness 3b (2-Atom Gluing Transition `{a, b}`):** For distinct atoms `a ≠ b`, the Čech
transition cocycle `atomSection a -ᵥ atomSection b : EvenFinset` over `{a} ∪ {b} = {a, b}` equals
the 2-element even subset `{a, b}` (`card = 2`, `(2 : ZMod 2) = 0`, non-zero in `EvenFinset`). -/
theorem atomSection_vsub_val_of_ne {a b : ℕ} (hab : a ≠ b) :
    (atomSection a -ᵥ atomSection b).1 = {a, b} :=
  singleton_symmDiff_singleton_of_ne hab

/-- Cardinality, mod-2 parity, and non-triviality of the Čech coboundary `{a, b}` (`a ≠ b`). -/
theorem atomSection_vsub_card_and_ne_zero {a b : ℕ} (hab : a ≠ b) :
    (atomSection a -ᵥ atomSection b).1.card = 2 ∧
      (((atomSection a -ᵥ atomSection b).1.card : ZMod 2) = 0) ∧
      atomSection a -ᵥ atomSection b ≠ 0 := by
  rw [atomSection_vsub_val_of_ne hab, Finset.card_pair hab]
  refine ⟨rfl, by decide, ?_⟩
  intro hZero
  have hVal := congrArg Subtype.val hZero
  rw [atomSection_vsub_val_of_ne hab, evenFinset_zero_val] at hVal
  exact Finset.insert_ne_empty a {b} hVal

