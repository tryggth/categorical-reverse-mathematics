/-! ### Layer 1: Inhabitation (Non-Degeneracy of Formalized Carriers) -/

/-- Layer 1 witness: `Equiv.Perm ℕ` is `Nontrivial` (`1 ≠ Equiv.swap 0 1`). -/
theorem permNat_exists_ne : ∃ σ τ : Equiv.Perm ℕ, σ ≠ τ := by
  refine ⟨1, Equiv.swap 0 1, fun h ↦ ?_⟩
  have h0 : (1 : Equiv.Perm ℕ) 0 = (Equiv.swap 0 1) 0 := congrArg (fun π : Equiv.Perm ℕ ↦ π 0) h
  simp at h0

/-- Layer 1 concrete `Nontrivial (Equiv.Perm ℕ)` witness. -/
def permNatNontrivialCheck : Nontrivial (Equiv.Perm ℕ) :=
  ⟨permNat_exists_ne⟩

/-- Layer 1 instance: `EvenFinset` is `Nontrivial` (`∅ ≠ {0, 1}`). -/
instance instNontrivialEvenFinset : Nontrivial EvenFinset :=
  ⟨⟨0, atomSection 0 -ᵥ atomSection 1,
    (atomSection_vsub_card_and_ne_zero (by decide : (0 : ℕ) ≠ 1)).2.2.symm⟩⟩

/-- Explicit existential non-degeneracy witness on `EvenFinset`. -/
theorem evenFinset_exists_ne : ∃ x y : EvenFinset, x ≠ y :=
  exists_pair_ne EvenFinset

/-- Layer 1 instance: `T_odd` is `Nontrivial` (`{0} ≠ {1}`). -/
instance instNontrivialTOdd : Nontrivial T_odd := by
  refine ⟨⟨atomSection 0, atomSection 1, fun h ↦ ?_⟩⟩
  have hmem : (0 : ℕ) ∈ (atomSection 1).1 := by
    rw [← h]
    simp
  simp at hmem

/-- Explicit existential non-degeneracy witness on `T_odd`. -/
theorem t_odd_exists_ne : ∃ x y : T_odd, x ≠ y :=
  exists_pair_ne T_odd

/-! ### Layer 2: Bidirectional Separation (Positive & Negative Witnesses for Core Predicates) -/

/-- Layer 2 positive witness for `IsOpenSubgroup`: `pointwiseStabilizer {0}` is open (and strictly
proper). -/
theorem isOpenSubgroup_stabilizer_zero :
    IsOpenSubgroup (pointwiseStabilizer ({0} : Finset ℕ)) :=
  isOpenSubgroup_stabilizer {0}

/-- Layer 2 negative counter-witness 1 for `IsOpenSubgroup`: the trivial subgroup `⊥` is **not**
open in `Equiv.Perm ℕ`. -/
theorem not_isOpenSubgroup_bot :
    ¬ IsOpenSubgroup (⊥ : Subgroup (Equiv.Perm ℕ)) := by
  rintro ⟨F, hF⟩
  let a : ℕ := F.sup id + 1
  have hmem : Equiv.swap a (a + 1) ∈ pointwiseStabilizer F := by
    intro x hx
    have hle : id x ≤ F.sup id := Finset.le_sup (f := id) hx
    dsimp only [id] at hle
    exact Equiv.swap_apply_of_ne_of_ne (by omega) (by omega)
  have hbot : Equiv.swap a (a + 1) = 1 := Subgroup.mem_bot.mp (hF hmem)
  have happ : (Equiv.swap a (a + 1)) a = (1 : Equiv.Perm ℕ) a :=
    congrArg (fun π : Equiv.Perm ℕ ↦ π a) hbot
  rw [Equiv.swap_apply_left, Equiv.Perm.one_apply] at happ
  omega

/-- The subgroup of permutations of `ℕ` preserving parity (`Even (σ n) ↔ Even n` for all `n`),
providing a non-trivial (`≠ ⊥`), proper (`≠ ⊤`), closed-but-non-open subgroup of `Equiv.Perm ℕ`. -/
def parityPreservingSubgroup : Subgroup (Equiv.Perm ℕ) where
  carrier := {σ : Equiv.Perm ℕ | ∀ n : ℕ, Even (σ n) ↔ Even n}
  mul_mem' {σ τ} hσ hτ n := (hσ (τ n)).trans (hτ n)
  one_mem' _ := Iff.rfl
  inv_mem' {σ} hσ n := by
    have h := hσ (σ⁻¹ n)
    simpa using h.symm

/-- Layer 2 negative counter-witness 2 for `IsOpenSubgroup`: `parityPreservingSubgroup` is strictly
non-trivial (`≠ ⊥`) and proper (`≠ ⊤`), yet **not** open in `Equiv.Perm ℕ`. -/
theorem not_isOpenSubgroup_parityPreservingSubgroup :
    parityPreservingSubgroup ≠ ⊥ ∧
      parityPreservingSubgroup ≠ ⊤ ∧
      ¬ IsOpenSubgroup parityPreservingSubgroup := by
  refine ⟨?_, ?_, ?_⟩
  · intro hBot
    have hmem : Equiv.swap 0 2 ∈ parityPreservingSubgroup := by
      intro n
      by_cases h0 : n = 0
      · subst h0
        decide
      · by_cases h2 : n = 2
        · subst h2
          decide
        · rw [Equiv.swap_apply_of_ne_of_ne h0 h2]
    have h1 : Equiv.swap (0 : ℕ) 2 = 1 := Subgroup.mem_bot.mp (hBot ▸ hmem)
    have happ := congrArg (fun π : Equiv.Perm ℕ ↦ π 0) h1
    simp at happ
  · intro hTop
    have hmem : Equiv.swap 0 1 ∈ parityPreservingSubgroup := by
      rw [hTop]
      trivial
    have h0 := (hmem 0).mpr ⟨0, rfl⟩
    rw [Equiv.swap_apply_left] at h0
    rcases h0 with ⟨k, hk⟩
    omega
  · rintro ⟨F, hF⟩
    let m : ℕ := F.sup id + 1
    let a : ℕ := 2 * m
    have hmem : Equiv.swap a (a + 1) ∈ pointwiseStabilizer F := by
      intro x hx
      have hle : id x ≤ F.sup id := Finset.le_sup (f := id) hx
      dsimp only [id] at hle
      exact Equiv.swap_apply_of_ne_of_ne (by omega) (by omega)
    have hpar := (hF hmem a).mpr ⟨m, by omega⟩
    rw [Equiv.swap_apply_left] at hpar
    rcases hpar with ⟨k, hk⟩
    omega

/-- Layer 2 positive witness for normality of open subgroups: `⊤` is both open and normal. -/
theorem normal_and_open_top :
    IsOpenSubgroup (⊤ : Subgroup (Equiv.Perm ℕ)) ∧ (⊤ : Subgroup (Equiv.Perm ℕ)).Normal :=
  ⟨isOpenSubgroup_top, inferInstance⟩

/-- Layer 2 negative counter-witness for normality of open subgroups: `pointwiseStabilizer {0}` is
open, **not** normal. -/
theorem not_normal_stabilizer_zero :
    ¬ (pointwiseStabilizer ({0} : Finset ℕ)).Normal := by
  intro hNorm
  have hTop : pointwiseStabilizer ({0} : Finset ℕ) = ⊤ :=
    @open_normal_eq_top (pointwiseStabilizer {0}) hNorm (isOpenSubgroup_stabilizer {0})
  exact (ne_of_lt (pointwiseStabilizer_lt_top_of_nonempty (Finset.singleton_nonempty 0))) hTop

/-- Layer 2 negative counter-witness for finite index among open subgroups:
`pointwiseStabilizer {0}` is open, **not** of finite index in `Equiv.Perm ℕ`. -/
theorem not_finiteIndex_stabilizer_zero :
    ¬ (pointwiseStabilizer ({0} : Finset ℕ)).FiniteIndex := by
  intro hFin
  have hTop : pointwiseStabilizer ({0} : Finset ℕ) = ⊤ :=
    @open_finiteIndex_eq_top (pointwiseStabilizer {0}) (isOpenSubgroup_stabilizer {0}) hFin
  exact (ne_of_lt (pointwiseStabilizer_lt_top_of_nonempty (Finset.singleton_nonempty 0))) hTop

/-- Layer 2 bidirectional separation for `T_odd` sections: empty over `∅` vs. nonempty over `{0}`.
-/
theorem layer2_sep_t_odd_sections :
    IsEmpty {t : T_odd // ∀ σ ∈ pointwiseStabilizer (∅ : Finset ℕ), σ • t = t} ∧
      Nonempty {t : T_odd // ∀ σ ∈ pointwiseStabilizer ({0} : Finset ℕ), σ • t = t} :=
  ⟨isEmpty_t_odd_sections_empty, nonempty_t_odd_sections_singleton 0⟩

/-- Layer 2 bidirectional separation for Guardrail 5 coset global sections: nonempty for `⊤` vs.
empty for `pointwiseStabilizer {0}`. -/
theorem layer2_sep_guardrail5_coset_globalSections :
    Nonempty {x : Equiv.Perm ℕ ⧸ (⊤ : Subgroup (Equiv.Perm ℕ)) //
        ∀ g : Equiv.Perm ℕ, g • x = x} ∧
      IsEmpty {x : Equiv.Perm ℕ ⧸ pointwiseStabilizer ({0} : Finset ℕ) //
        ∀ g : Equiv.Perm ℕ, g • x = x} :=
  ⟨(nonempty_globalSections_quotient_iff_eq_top ⊤).mpr rfl,
    isEmpty_globalSections_quotient_pointwiseStabilizer (Finset.singleton_nonempty 0)⟩

