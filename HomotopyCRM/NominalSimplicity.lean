/-- Derived sanity lemma 1: continuity of `EvenFinset` and `T_odd` as objects of `Cont(Sym(ℕ))`
(every element has an open stabilizer containing `pointwiseStabilizer F` for some `F : Finset ℕ`).
-/
theorem derived_continuity_evenFinset_and_t_odd :
    (∀ E : EvenFinset, ∃ F : Finset ℕ, ∀ g ∈ pointwiseStabilizer F, g • E = E) ∧
      (∀ T : T_odd, ∃ F : Finset ℕ, ∀ g ∈ pointwiseStabilizer F, g • T = T) :=
  ⟨fun E ↦ ⟨E.1, evenFinset_fixed_by_stabilizer E⟩,
